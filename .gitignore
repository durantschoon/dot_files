.DS_Store
CHECKLIST.md

# Python caches next to scripts in bin/
**/__pycache__/
*.py[cod]

# Cursor
# NOTE: a leading "./" does not work in .gitignore -- patterns are already
# relative to this file -- and the directory is ".cursor", not "cursor".
.cursor/

# Espanso private snippets (in submodule espanso/private; local copy must not be committed)
espanso/match/private.yml

# Claude Code per-machine permission approvals (accumulates as prompts are
# approved; /gnu/store paths in it are generation-specific anyway)
.claude/settings.local.json
