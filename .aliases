alias py="echo 'Using ipython instead, duh' ; ipython"
alias pylint="pylint --output-format=colorized"
alias s.a='source ~/.aliases'
alias s.b='source ~/.bashrc'
alias s2n='tr " " "\012"'
alias sg='set | grep'
alias spew='wget -qO-' # URL to spew the contents to stdout
# Tailscale.  This was `ts' until moreutils landed in the profile
# (2026-08-14) -- moreutils ships a real `ts' (timestamp-prefix a pipe, e.g.
# `tail -f log | ts') that the alias shadowed, exactly as the old comment
# here predicted.  `tls' is free: no such binary exists, and the plausible
# collisions were rejected on purpose -- `tsc' is the TypeScript compiler,
# and anything longer defeats the point of an alias.
alias tls='tailscale'
alias up='cd ..'
alias up2='cd ../..'
alias up3='cd ../../..'
alias up4='cd ../../../..'
alias watch-df='watch -n 1 df -h .'
alias wh=which
alias wo=workon
alias ,=pd
alias ,.=pp

# watch a function
# Note: tmstat is defined for Darwin only
# Example: watchf tmstat
# Example: watchf tmstat 2    # refresh every 2 seconds
watchf() {
    local fn=$1
    local interval=$2
    local cmd
    cmd="bash -c $(printf '%q' "$(declare -f "$fn"); $fn")"
    if [[ -n $interval && $interval =~ ^[0-9]+(\.[0-9]+)?$ ]]; then
        watch -n "$interval" "$cmd"
    else
        watch "$cmd"
    fi
}

