###############################################################################
# Cloud Services
###############################################################################
#
# A standing section, not a scratchpad: several providers are in use at once and
# one migration is in progress, so "which service, and what is set up for it
# here" is a recurring question.  Aliases below, inventory first.
#
# MIGRATION IN PROGRESS (2026): consolidate onto Proton Drive, and stop paying
# for the overlap.  Until it finishes several are live at once, so anything
# added here should say which one it targets rather than assuming a default.
#
# KEEPING
#
#   Proton Drive   Incoming primary.  NO official Linux client -- access is
#                  rclone's `protondrive' backend, which is reverse-engineered.
#                  Guix packages rclone (1.72.1 at the current pin) and that
#                  build does include the backend.
#   Google Drive   rclone's `drive' backend, or GNOME Online Accounts, which
#                  surfaces it through gvfs at /run/user/$UID/gvfs.  GNOME is
#                  already running gvfsd-fuse here, so that route needs no new
#                  packages -- but see the inotify note below.
#
# DROPPING -- both are paid, and the storage is already covered above
#
#   Dropbox        Cancel once its contents are moved.  Genuinely good at the
#                  job and the only one here with a real Linux daemon (not
#                  packaged in Guix; rclone's `dropbox' backend is the portable
#                  route).  It is going for cost, not for any fault -- worth
#                  recording so this does not get re-litigated as a technical
#                  question later.
#   iCloud Drive   Cancel.  Paying for it alongside the above is the whole
#                  reason it is on this list.  Web only: no Linux client, and
#                  rclone has no backend for it, so there is no scripted way to
#                  bulk-move the contents out -- budget manual time for that
#                  before cancelling, and do it in that order.
#
# TWO RULES, both learned the hard way:
#
#   1. Credentials never live in this repo.  It is public, and rclone.conf
#      stores passwords OBSCURED, not encrypted -- `rclone obscure' is
#      reversible by anyone with rclone.  Keep ~/.config/rclone/rclone.conf out
#      of version control and deploy it out of band, the same rule
#      system/README.md applies to wifi PSKs and private keys.
#
#   2. Do not sync anything git can version.  Espanso match files were tried on
#      Proton Drive and it was unreliable; they now live in dot_files itself
#      (espanso/match/base.yml plus the espanso/private submodule), which is
#      versioned, works offline and needs no credentials on the machine.
#      Reach for a cloud drive only for content that genuinely does not belong
#      in git.
#
#      The technical half of that: a FUSE mount -- rclone mount, or gvfs --
#      does not deliver inotify events, so tools that reload on file change
#      (espanso among them) silently miss remote edits.  Sync to real disk
#      instead of mounting when anything is watching the files.
#
# CANDIDATE TO EVALUATE: git-annex (Joey Hess), for the backup strategy the
# migration above forces anyway.
#
# What it is: git for files too large for git.  Git tracks a content-hash
# pointer; the content lives outside history, on any subset of your
# repos/drives/remotes.  Every clone knows about every file (`git annex
# whereis`); content is only where you put it.  The feature that earns the
# evaluation: `git annex drop` REFUSES to delete a local copy unless it can
# verify `numcopies' other copies exist -- "can I cancel this subscription
# yet?" becomes a checkable question instead of a feeling.  SSDs, the Mac
# mini over SSH/tailscale, and Proton Drive (rclone special remote) can all
# be copy-holding remotes.
#
# WHAT IT IS NOT: a backup tool in the snapshot sense.  git-annex manages
# WHERE current file contents live; it does not give you "the directory as
# it was last Tuesday" unless you commit that often.  For point-in-time
# snapshots of changing data the standard answers are restic or borg, and a
# real backup strategy here likely PAIRS one of them with git-annex rather
# than choosing between: annex for the large mostly-immutable archive
# (photos, media, datasets), restic/borg for snapshotting the mutable rest.
# Evaluate them together, not annex alone.
#
# LEARNING CURVE, honestly, so future-me budgets it right:
#
#   basics (an afternoon)   add/get/copy/drop/whereis feel like git within
#                           hours if you already think in git.
#   the conceptual hump     worktree files are SYMLINKS into
#                           .git/annex/objects (read-only content by
#                           design); `git annex unlock' / v7 unlocked files
#                           exist for tools that must write in place.  This
#                           is the #1 source of early confusion, and some
#                           apps (atomic-save editors, some photo managers)
#                           need unlocked mode to cooperate.
#   the git-annex branch    location metadata syncs between repos on its own
#                           branch; `git annex sync' has more moving parts
#                           than push/pull.  Magic until read about, then
#                           fine.
#   special remotes         each backend (rclone, S3, ssh) has its own
#                           setup, plus an encryption decision
#                           (shared/hybrid/pubkey) made AT CREATION and
#                           awkward to change later.
#   trust-it-with-real-     a weekend of deliberate play: scratch repo +
#   data threshold          one SSD + one rclone remote, then practice
#                           numcopies, drop-refusal, `git annex fsck', and
#                           one full simulated drive loss BEFORE moving
#                           anything irreplaceable.
#   the long tail           preferred-content expressions (wanted/group --
#                           a little declarative language for "laptop wants
#                           recent, mini wants everything") and the
#                           assistant daemon.  Optional; ignore until the
#                           basics are boring.
#
# Packaged in Guix (Haskell; the substitute is hefty, the experience fine).
# When the evaluation happens: scratch repo first per the threshold note,
# and the fsck routine belongs in the plan from day one, not as an
# afterthought.
#
# No aliases yet -- nothing is configured on this machine.  When rclone (or
# git-annex) lands, it goes in home/common.scm via `make add-pkg', and
# per-remote aliases belong here.

###############################################################################
# Zsh Aliases
###############################################################################

if [ -n "$ZSH_VERSION" ]; then
    # assume Zsh

    alias ctags='=ctags -eR'

    alias funcs='print -l ${(ok)functions}' # list all functions

    if [[ -f /usr/local/bin/pup ]] && command -v pup >/dev/null && alias pup >/dev/null 2>&1; then
        unalias pup
    fi

    # supposedly works on mac and linux
    alias ollama_update="ollama list | awk -F: 'NR>1 && !/reviewer/ {system(\"ollama pull \"\$1)}'"

    if command -v pup > /dev/null; then
        alias ollama_library_list='(\
              echo "Listing all available models from https://ollama.com/library\n"; \
              curl -s "https://ollama.com/library" | pup "#repo ul li a div:nth-child(1) h2 div span text{}" | sort) | \
              more'
    fi

    ###########################################################################
    # Re-source a zsh config file.
    #
    # These aliases name files that exist on SOME of these machines.  Under
    # guix home they mostly do not, and that is not a broken deployment:
    # home-zsh-configuration CONCATENATES the files in its zshrc/zshenv/zprofile
    # fields into one generated file per hook, under $ZDOTDIR (here
    # ~/.config/zsh), instead of symlinking each into $HOME.  So .shared.zshrc,
    # .shared.zshenv and .shared.zprofile have no separate existence to source;
    # their contents are already inside $ZDOTDIR/.zshrc and friends.
    #
    # Sourcing a missing file is a hard error that aborts the rest of a compound
    # alias, which is what made `s.zall' quit partway through.  Route everything
    # through this helper so an absent file reports and is stepped over.
    # The echo is NOT chained to the source with &&.  A config file's exit
    # status is whatever its last command happened to return, which says nothing
    # about whether it loaded: .shared.zshenv ends with
    # `[ -f /usr/local/bin/fzf ] && eval ...', false on any machine without a
    # /usr/local, so `source ... && echo' reported nothing for a file that had
    # just been sourced perfectly well.
    _source_if() {
        if [ -f "$1" ]; then
            source "$1"
            echo "  sourced  $1"
        else
            echo "  skipped  $1 (not present on this machine)"
        fi
    }

    # The file that actually holds everything under guix home.  ${ZDOTDIR:-$HOME}
    # keeps this correct on machines that never set ZDOTDIR.
    alias s.z='_source_if "${ZDOTDIR:-$HOME}/.zshrc"'
    alias s.ze='_source_if "${ZDOTDIR:-$HOME}/.zshenv"'
    # NOT ~/.zprofile: on a guix home machine that path is a stale leftover from
    # before guix home managed zsh, while the live one is under $ZDOTDIR.
    alias s.zp='_source_if "${ZDOTDIR:-$HOME}/.zprofile"'

    # The per-fragment aliases, for machines that do symlink them into $HOME.
    alias s.zs='_source_if ~/.shared.zshrc'
    alias s.zes='_source_if ~/.shared.zshenv'
    alias s.zps='_source_if ~/.shared.zprofile'
    alias s.zh='_source_if ~/dot_files/.home.zshrc'
    alias s.zw='_source_if ~/dot_files/.work.zshrc'
    alias s.zws='_source_if ~/dot_files/.shared.work.zshrc'

    # Everything, in the order zsh itself reads it, skipping what is absent.
    alias s.zall='for _f in "${ZDOTDIR:-$HOME}/.zshenv" "${ZDOTDIR:-$HOME}/.zprofile" ~/.aliases "${ZDOTDIR:-$HOME}/.zshrc"; do _source_if "$_f"; done; unset _f'

    # Guix Home: reconfigure dotfiles from ~/dot_files and return here
    dot-apply() {
        pushd ~/dot_files >/dev/null || return 1
        make apply || { popd >/dev/null; return 1; }
        popd >/dev/null
        source ~/.aliases 2>/dev/null
    }
    alias da=dot-apply

    dot-apply-wayland() {
        pushd ~/dot_files >/dev/null || return 1
        make apply-wayland || { popd >/dev/null; return 1; }
        popd >/dev/null
        source ~/.zshenv 2>/dev/null
        source ~/.aliases 2>/dev/null
    }
    alias daw=dot-apply-wayland

    alias lth='ls -lt | head; latest=`ls *(.om[1])`'		# . regular file, o sorted, m mod time, 1 first
    alias lthd='ls -lt | head; latest=`ls -d *(/om[1])`'	# / directory, o sorted, m mod time, 1 first
    # z move?
    # zmv -W '*.lis' '*.txt'
    alias zmvw='zmv -W'
    alias ztheme='(){ export ZSH_THEME="$@" && source $ZSH/oh-my-zsh.sh }'
    # better for light modes
    # ztheme sobole
    # ztheme xiong-chiamiov

    # alias branches="glo | grep -E '\[[a-zA-Z0-9-]+\]'"

    spacemacs_force_clean () {
        read -q "?Do you want to continue removing all .elc files and elpa? (y/n) " || return
        pushd ~/.spacemacs.d
        echo "\nremoving all spacemacs .elc files..."
        find . -name "*.elc" -delete
        echo "removing elpa..."
        =rm -rf ~/.emacs.d/elpa
        popd
    }

    if [ -f /usr/local/bin/clojars-lookup ]; then
        function clojars-lookup-lein() {
            clojars-lookup "$@" -lein
        }
        function clojars-lookup-deps() {
            clojars-lookup "$@" -deps
        }
    fi

    # print the branches which are recognized by "git branchstack"
    branches () {
        glo | \
        perl -ne 's/\([^)]*\)//g; s/  +/ /g; print' | \
        perl -ne '@fields = split; if ($fields[1] =~ /\[[a-zA-Z0-9-]+\]/) { print }'
    }

    # try these
    alias -g latestd='*(/om[1])' # newest directory
    alias -g latestf='*(.om[1])' # newest file

    alias llrm='echo "Paste ls -lt output for files to delete and ^D when done"; /bin/rm -rf `awk '\''{print $9}'\''`'

    ee () { echo $* ; $* ; } # trailing `;' is for bash's parser -- see f2m below

    # nr () { echo "npm run $*" ; npm run $* }

    [[ -f /Users/durant/.pyenv/shims/python ]] && alias python3=/Users/durant/.pyenv/shims/python

    alias heroku_logs='heroku logs --force-colors --tail --app'

    # _heroku_logs_completions() {
    #     local -a apps
    #     # apps=("${(f)$(heroku apps | awk '/^[^=]/ {print $1}')}")


    #     apps=(\"app1\" \"app2\" \"app3\")


    #     echo "Apps found: ${apps[@]}"  # Debugging: List all apps found
    #     compadd "$@" -- $apps
    # }
    # compdef _heroku_logs_completions heroku_logs

    # export XDG_CACHE_HOME="$HOME/.cache"
    # [[ ! -d "$XDG_CACHE_HOME/zsh" ]] && mkdir -p "$XDG_CACHE_HOME/zsh"
    # [[ ! -f "$XDG_CACHE_HOME/zsh/.zcompcache" ]] && touch "$XDG_CACHE_HOME/zsh/.zcompcache"

    # zstyle ':completion:*' cache-path "$XDG_CACHE_HOME/zsh/.zcompcache"
    # zstyle ':completion:*' use-cache on

    # remove milliseconds
    epoch_date () { date -r $(echo $1 | cut -c1-10); } # epoch_date 1679656475630
    epoch_date2 () { date -r $(echo $1 | cut -c1-10) +'%Y-%m-%d %H:%M:%S'; }

    rm() { [[ "$(uname)" == "Darwin" ]] && (mv $* ~/.Trash) || =rm $* ; } # builtin rm; the `;' is for bash -- see f2m

    function killport(){ lsof -nti:$1 | xargs kill -9 ; } # killport 3000

    function rg () {
        [[ -d .git/ ]] && echo 'skipping .git/ dir ...';
        local arg=$1; shift
        =rg --hidden $arg -g '!.git/*' $@
    }
    function rg_with_git () { =rg --hidden $* ; } # `;' for bash -- see f2m

    function psg () {
        ps -ef | (head -n 1; tail -n +2 | grep "$@" | grep -v grep)
    }

    function mdc () {
        mkdir -p $1
        cd $1
    }

    function pd () {
        pushd $1
        ds
    }

    function p () {
        ls -d $PWD/$1
    }

    function pdfsearch() {
        pdfgrep -nir "$@" .
    }

    get_pids_from_port() {
        if [[ -z $1 ]]; then
            echo "Usage: get_pids_from_port <port_number>"
            return 1
        fi

        local port=$1
        local pids=$(lsof -t -i :$port)

        if [[ -z $pids ]]; then
            echo "No processes found using port $port."
            return 1
        fi

        echo $pids
    }

    # Example usage:
    # pids=$(get_pids_from_port 8000)
    # echo $pids
    # kill -9 $pids
    # or
    # kill -9 $(get_pids_from_port 8000)

    # Example Usage: grep_git_branches clojure-term-colors
    grep_git_branches() {
        for branch in $(git branch | awk '{print $1}'); do # this $1 is escaped for awk
            echo "Branch: $branch\n" $(git grep $1 $(git rev-parse $branch)) "\n" # this $1 is the first argument
        done
    }

    # ----------------------------------------------------------------------
    # PYTHON
    MVP="$HOME/.ipython/profile_default/startup/money_value.py"
    if [ -x "$MVP" ]; then
        unalias f2m m2f half 2>/dev/null
        # The `;' before each `}' is load-bearing for BASH, which never runs
        # these (they sit in the zsh guard) but must still PARSE them: bash
        # requires a command terminator before a closing brace, while zsh
        # accepts a bare `}' after a pipeline. Without the semicolons the
        # function never closes, the guard's if-body swallows everything
        # after it, and bash reports "syntax error near unexpected token
        # else" hundreds of lines from the cause.
        function f2m () { "$MVP" f2m "$@" | pbcopy; }
        function m2f () { "$MVP" m2f "$@" | pbcopy; }
        function half () { "$MVP" half "$@" | pbcopy; }
        # e.g. half \$3,604.67 && echo `pbpaste`
    else
        unset -f f2m m2f half 2>/dev/null
        unset MVP
    fi

    # aliases to transition from virtualenvwrapper to uv

    # TODO test this and post publicly as a gist

    # Create a new virtual environment
    # mkvirtualenv 3.9 myenv
    uv_mkvirtualenv() {
        echo "Executing: uv venv --python=python$1 $2"
        uv venv --python=python$1 $2
    }

    # Set up for mapping venv names to directories
    # Check if ~/.venv_map exists; create if it doesn't
    if [ ! -f "$HOME/.venv_map" ]; then
        touch "$HOME/.venv_map"
        echo "# Virtual Environment to Project Directory Mapping" > "$HOME/.venv_map"
        echo "Created ~/.venv_map file."
    fi

    # Function to set virtual environment to project directory mapping
    uv_set_venv_dir() {
        if [ $# -ne 2 ]; then
            echo "Usage: uv_set_venv_dir <virtualenv_name> <project_directory>"
            return 1
        fi

        local venv_name="$1"
        local project_dir="$2"

        # Check if the project directory exists
        if [ ! -d "$project_dir" ]; then
            echo "Error: Directory '$project_dir' does not exist."
            return 1
        fi

        # Remove existing entry for the virtual environment, if any
        grep -v "^$venv_name " "$HOME/.venv_map" > "$HOME/.venv_map.tmp" && mv "$HOME/.venv_map.tmp" "$HOME/.venv_map"

        # Add the new mapping
        echo "$venv_name $project_dir" >> "$HOME/.venv_map"
        echo "Mapped virtual environment '$venv_name' to project directory '$project_dir'."
    }

    # Function to activate a virtual environment and change to its project directory
    uv_workon() {
        if [ -z "$1" ]; then
            echo "Please provide a virtual environment name."
            return 1
        fi

        local venv_name="$1"
        local venv_dir="$HOME/.virtualenvs/$venv_name"

        if [ ! -d "$venv_dir" ]; then
            echo "Virtual environment '$venv_name' does not exist."
            return 1
        fi

        # Read the .venv_map file, ignoring comment lines, and find the project directory
        local project_dir
        project_dir=$(grep -v "^[[:space:]]*#" "$HOME/.venv_map" | awk -v venv="$venv_name" '$1 == venv {print $2}')

        if [ -n "$project_dir" ]; then
            if [ -d "$project_dir" ]; then
                cd "$project_dir" || return
                echo "Changed directory to $project_dir"
            else
                echo "Project directory '$project_dir' does not exist."
                return 1
            fi
        fi

        source "$venv_dir/bin/activate"
        echo "Activated virtual environment '$venv_name'"
    }

    # Deactivate the current virtual environment
    uv_deactivate() {
        echo "Executing: deactivate"
        deactivate
    }

    # List all virtual environments
    uv_lsvirtualenv() {
        echo "Executing: uv venv list"
        uv venv list
    }

    # Remove a virtual environment
    uv_rmvirtualenv() {
        echo "Executing: uv venv remove $1"
        uv venv remove "$1"
    }

    # ----------------------------------------------------------------------

    # spacemacs

    function switch_spacemacs() {
        local EMACS_D_LINK=$HOME/.emacs.d
        local EMACS_ORIG_D=$HOME/.emacs.d_ORIG_EMACS
        local SPACEMACS_D=$HOME/.emacs.d_SPACEMACS
        if [[ -d $EMACS_ORIG_D && -d $SPACEMACS_D && -h $EMACS_D_LINK ]]; then
            if [[ "$(readlink $EMACS_D_LINK)" == "$EMACS_ORIG_D" ]]; then
                =rm $EMACS_D_LINK
                ln -s $SPACEMACS_D $EMACS_D_LINK
                echo "Switched to spacemacs"
            elif [[ "$(readlink $EMACS_D_LINK)" == "$SPACEMACS_D" ]]; then
                =rm $EMACS_D_LINK
                ln -s $EMACS_ORIG_D $EMACS_D_LINK
                echo "Switched to original emacs"
            fi
        else
            echo "Not configured to test spacemacs"
        fi
    }

    # -----

    # $1 = type; 0 - both, 1 - tab, 2 - title
    # rest = text
    setTerminalText () {
        # echo works in bash & zsh
        local mode=$1 ; shift
        echo -ne "\033]$mode;$@\007"
    }
    stt_both  () { setTerminalText 0 $@; }
    stt_tab   () { setTerminalText 1 $@; }
    stt_title () { setTerminalText 2 $@; }

    # mac

    ###############################################################################
    # global aliases
    # example: C

    # from: http://grml.org/zsh/zsh-lovers.html

    # $latest alias -g C='| wc -l'
    # $ grep alias ~/.zsh/* C
    # 443

    alias -g ...='../..'
    alias -g ....='../../..'
    alias -g .....='../../../..'
    alias -g CA="2>&1 | cat -A"
    alias -g C='| wc -l'

    # Merge stderr into stdout, spelled as an arrow.
    #   make check err→out | tail -5
    #
    # The arrow is U+2192, NOT an ASCII "->".  This is the whole reason the
    # name looks exotic, so it is worth stating before someone "fixes" it:
    #
    #   err->out    parses as the word `err-' followed by a redirection to a
    #               file named `out'.  Never reaches alias lookup.
    #   err-\>out   escapes the `>', which makes it a QUOTED word -- and zsh
    #               does not alias-expand any word containing quoting.  It
    #               arrives at the command as the literal filename `err->out'.
    #   err→out     `→' is an ordinary character to the parser, so no quoting
    #               is needed and the alias expands.
    #
    # Typed via an espanso expansion rather than a keyboard key.
    alias -g 'err→out'='2>&1'

    # Log to ~/logs directory (creates directory if needed)
    # Usage: command LOG filename
    # Example: ls -la LOG mylog.txt
    # Example: make build LOG build.log
    LOG() {
        local logfile="$1"
        mkdir -p ~/logs
        tee ~/logs/"$logfile"
    }

    # Log with timestamped filename (creates directory if needed)
    # Usage: command LOGT
    # Example: make build LOGT
    # Creates: ~/logs/command-20241216-143022.log
    alias -g LOGT='| (mkdir -p ~/logs; tee ~/logs/command-$(date +%Y%m%d-%H%M%S).log)'

    # Log with prompt for filename (creates directory if needed)
    # Usage: command LOGP
    # Example: make build LOGP
    # Prompts: "Log filename: " then logs to that file
    alias -g LOGP='| (read "logfile?Log filename: "; mkdir -p ~/logs; tee ~/logs/$logfile)'

    alias -g D="DISPLAY=:0.0"
    alias -g DN=/dev/null
    alias -g ED="export DISPLAY=:0.0"
    alias -g EG='|& egrep'
    alias -g EH='|& head'
    alias -g EL='|& less'
    alias -g ELS='|& less -S'
    alias -g ETL='|& tail -20'
    alias -g ET='|& tail'
    alias -g F=' | fmt -'
    alias -g G='| egrep'
    alias -g H='| head'
    alias -g HL='|& head -20'
    alias -g Sk="*~(*.bz2|*.gz|*.tgz|*.zip|*.z)"
    alias -g LL="2>&1 | less"
    alias -g L="| less"
    alias -g LS='| less -S'
    alias -g MM='| most'
    alias -g M='| more'
    alias -g NE="2> /dev/null"
    alias -g NS='| sort -n'
    alias -g NUL="> /dev/null 2>&1"
    alias -g PIPE='|'
    alias -g R=' > /c/aaa/tee.txt '
    alias -g RNS='| sort -nr'
    alias -g S='| sort'
    alias -g TL='| tail -20'
    alias -g T='| tail'
    alias -g US='| sort -u'
    alias -g VM=/var/log/messages
    alias -g X0G='| xargs -0 egrep'
    alias -g X0='| xargs -0' # see https://www.gnu.org/software/parallel instead of xargs
    # brew install parallel
    # on mac you need final - below
    # seq 1000 | parallel -N100 –pipe –slf instances "(hostname; wc -l) | paste -sd: - | bc"
    F0 () { find $* -print0; } # use F0 to pipe to X0 or X0G (the `;' is for bash's parser -- see f2m above)
    alias -g XG='| xargs egrep'
    alias -g X='| xargs'

# elif [ -n "$BASH_VERSION" ]; then
    # assume Bash
fi

# -----------------------------------------------------------------------------
# Git Aliases (Oh-My-Zsh style)
# -----------------------------------------------------------------------------

# Helper functions for branch detection
git_current_branch() {
  git branch --show-current
}

git_main_branch() {
  command git rev-parse --git-dir &>/dev/null || return
  local ref
  for ref in refs/{heads,remotes/{origin,upstream}}/{main,master,trunk}; do
    if git show-ref -q "$ref"; then
      echo "${ref:t}"
      return
    fi
  done
  echo main
}

alias g='git'
alias ga='git add'
alias gaa='git add --all'
alias gapa='git add --patch'
alias gau='git add --update'
alias gav='git add --verbose'
alias gb='git branch'
alias gba='git branch -a'
alias gbd='git branch -d'
alias gbD='git branch -D'
alias gbl='git blame -b -w'
alias gbnm='git branch --no-merged'
alias gbr='git branch --remote'
alias gcb='git checkout -b'
alias gcd='git checkout $(git_main_branch)'
alias gcm='git checkout $(git_main_branch)'
alias gc='git commit -v'
alias gc!='git commit -v --amend'
alias gcn!='git commit -v --no-edit --amend'
alias gca='git commit -v -a'
alias gca!='git commit -v -a --amend'
alias gcan!='git commit -v -a --no-edit --amend'
alias gcans!='git commit -v -a -s --no-edit --amend'
alias gcam='git commit -a -m'
alias gcmsg='git commit -m'
alias gcs='git commit -S'
alias gco='git checkout'
alias gcor='git checkout --recurse-submodules'
alias gcl='git clone --recurse-submodules'
alias gclean='git clean -id'
alias gd='git diff'
alias gdca='git diff --cached'
alias gds='git diff --staged'
alias gdt='git diff-tree --no-commit-id --name-only -r'
alias gf='git fetch'
alias gfa='git fetch --all --prune'
alias gfo='git fetch origin'
alias gl='git pull'
alias gp='git push'
alias gpf!='git push --force'
alias grb='git rebase'
alias grbi='git rebase -i'
alias grhh='git reset --hard'
alias grs='git restore'
alias grst='git restore --staged'
alias gsta='git stash push'
alias gstp='git stash pop'
alias gstl='git stash list'
alias gstd='git stash drop'
alias gsts='git stash show --patch'
alias gst='git status'
alias gss='git status -s'
alias gsb='git status --short -b'
alias glum='git pull upstream $(git_main_branch)'
alias gpristine='git reset --hard && git clean -dffx'
alias ggpull='git pull origin $(git_current_branch)'
alias ggpush='git push origin $(git_current_branch)'
alias gpsup='git push --set-upstream origin $(git_current_branch)'

alias glog='git log --oneline --decorate --graph'
alias gloga='git log --oneline --decorate --graph --all'
alias glg='git log --stat'
alias glgp='git log --stat -p'
alias glo='git log --oneline --decorate'

# "date glo" -- compact log with dates/times/initials via bin/git-log-compact
alias dglo='git log-compact'
alias dglog='git log-compact --graph'
alias dgloga='git log-compact --graph --all'
