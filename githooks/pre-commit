#!/bin/sh
# pre-commit -- enforce the system/ invariants at the moment they can still be
# fixed cheaply.
#
# Install with `make install-hooks', which points core.hooksPath here. Because
# that is repo-local git config rather than a tracked file, a fresh clone needs
# the target run once; the hook cannot install itself.
#
# Bypass with `git commit --no-verify' when you genuinely need to (mid-rebase
# fixups, committing a known-broken WIP on a branch).
#
# Two deliberate design choices:
#
#   Scoped.  It fires only when the commit touches home/, system/, keyd.conf or
#   the Makefile. A hook that blocks commits unrelated to its subject gets
#   bypassed reflexively, and a reflexively bypassed hook guards nothing.
#
#   Staged, not working-tree.  `make check-system' reads files from disk, which
#   for a pre-commit hook is the wrong tree: you can stage a clean version over
#   a dirty working copy, or the reverse, and get an answer about neither. So
#   this exports the index to a temporary directory and runs the checks there,
#   against exactly the content being committed.

set -e

# Nothing this hook guards is in play -- get out of the way.
git diff --cached --name-only | grep -qE '^(home/|system/|keyd\.conf$|Makefile$)' || exit 0

echo "pre-commit: guarded files staged, running make check against the index"

tmp=$(mktemp -d) || exit 1
trap 'rm -rf "$tmp"' EXIT INT TERM

git checkout-index --prefix="$tmp/" -a

# Sharp edge, and the reason for the warning below: the Makefile comes from the
# index too. Add or edit a check without staging the Makefile and this runs the
# OLD ruleset against the new files.
#
# What makes that genuinely dangerous is that it still BLOCKS the commit -- with
# "No rule to make target 'check-whatever'" rather than a real finding. A hook
# that fails for the wrong reason is indistinguishable from one that works, and
# the natural reading of a red pre-commit is "good, it caught something." It did
# not. Stage the Makefile in the same commit as whatever it guards.
if ! git diff --quiet -- Makefile; then
    echo "pre-commit: NOTE -- Makefile has unstaged changes."
    echo "            These checks run the STAGED Makefile, not your working copy."
    echo "            If a target seems to be missing, that is why."
fi

# Run only the checks whose inputs are actually present. A commit that removes
# home/ or system/ has nothing for that half to check, and the Makefile globs
# would error rather than pass.
#
# Written as full if-blocks rather than `[ -d x ] && targets=...' because under
# `set -e' a trailing false test is itself a failing command, and the hook would
# abort with no output -- reading, from the outside, exactly like a pass.
targets=""
if [ -d "$tmp/home" ]; then
    targets="$targets check-session-coupling"
fi
if [ -d "$tmp/system" ]; then
    targets="$targets check-system"
fi

if [ -z "$targets" ]; then
    echo "pre-commit: neither home/ nor system/ in the staged tree, nothing to check"
    exit 0
fi

if make -C "$tmp" --no-print-directory $targets; then
    exit 0
else
    echo ""
    echo "pre-commit: BLOCKED. Fix the above, or bypass with --no-verify."
    exit 1
fi
