#!/bin/sh
# pre-commit -- enforce the system/ invariants at the moment they can still be
# fixed cheaply.
#
# Install with `make install-hooks', which points core.hooksPath here. Because
# that is repo-local git config rather than a tracked file, a fresh clone needs
# the target run once; the hook cannot install itself.
#
# Bypass with `git commit --no-verify' when you genuinely need to (mid-rebase
# fixups, committing a known-broken WIP on a branch).
#
# Two deliberate design choices:
#
#   Scoped.  It fires only when the commit touches home/, system/, keyd.conf,
#   the Makefile or bin/. A bin/-only commit runs just the shellcheck half
#   below, not make check. A hook that blocks commits unrelated to its subject gets
#   bypassed reflexively, and a reflexively bypassed hook guards nothing.
#
#   Staged, not working-tree.  `make check-system' reads files from disk, which
#   for a pre-commit hook is the wrong tree: you can stage a clean version over
#   a dirty working copy, or the reverse, and get an answer about neither. So
#   this exports the index to a temporary directory and runs the checks there,
#   against exactly the content being committed.

set -e

# Nothing this hook guards is in play -- get out of the way.
git diff --cached --name-only | grep -qE '^(home/|system/|keyd\.conf$|Makefile$|bin/)' || exit 0

tmp=$(mktemp -d) || exit 1
trap 'rm -rf "$tmp"' EXIT INT TERM

git checkout-index --prefix="$tmp/" -a

# bin/ half: shellcheck the STAGED shell scripts at severity error. The rule is
# the one `make check-shell' uses -- chosen by shebang, not extension: line 1
# names sh, bash or dash, directly or through env. Logic keeps moving out of
# the Makefile into bin/, so without this the extraction would shrink what the
# hook guards. No shellcheck (Guix ISO, pre-apply machine): say so, don't block.
bin_staged=$(git diff --cached --name-only --diff-filter=ACMRT -- bin/)
if [ -n "$bin_staged" ]; then
    if ! command -v shellcheck >/dev/null 2>&1; then
        echo "pre-commit: NOTE -- shellcheck not installed; staged bin/ scripts NOT checked"
    else
        sh_re='^#![[:space:]]*(/[^[:space:]]*/)?(env[[:space:]]+(-[^[:space:]]+[[:space:]]+)*)?(sh|bash|dash)([[:space:]]|$)'
        sc_failed=0
        sc_count=0
        while IFS= read -r f; do
            if [ -f "$tmp/$f" ] && head -n 1 "$tmp/$f" | grep -qE "$sh_re"; then
                sc_count=$((sc_count + 1))
                if ! (cd "$tmp" && shellcheck -S error "$f"); then
                    sc_failed=1
                fi
            fi
        done <<EOF
$bin_staged
EOF
        echo "pre-commit: shellcheck -S error on $sc_count staged bin/ shell script(s)"
        if [ "$sc_failed" -ne 0 ]; then
            echo ""
            echo "pre-commit: BLOCKED by shellcheck. Fix the above, or bypass with --no-verify."
            exit 1
        fi
    fi
fi

# Everything below is the make-check half, unchanged; a bin/-only commit stops here.
git diff --cached --name-only | grep -qE '^(home/|system/|keyd\.conf$|Makefile$)' || exit 0

echo "pre-commit: guarded files staged, running make check against the index"

# Sharp edge, and the reason for the warning below: the Makefile comes from the
# index too. Add or edit a check without staging the Makefile and this runs the
# OLD ruleset against the new files.
#
# What makes that genuinely dangerous is that it still BLOCKS the commit -- with
# "No rule to make target 'check-whatever'" rather than a real finding. A hook
# that fails for the wrong reason is indistinguishable from one that works, and
# the natural reading of a red pre-commit is "good, it caught something." It did
# not. Stage the Makefile in the same commit as whatever it guards.
if ! git diff --quiet -- Makefile; then
    echo "pre-commit: NOTE -- Makefile has unstaged changes."
    echo "            These checks run the STAGED Makefile, not your working copy."
    echo "            If a target seems to be missing, that is why."
fi

# A removed or renamed make target is a word people TYPE. docs/language.md is
# the repo's record of such changes, and it is the only thing that keeps an old
# name resolvable once the target is gone -- which matters, because the house
# style is to remove the old name rather than alias it. Nothing enforced this,
# so the row got written only when someone remembered.
#
# A NOTE, not a block: "removed a target line" is a proxy for "renamed
# something significant" and it will sometimes be wrong (deleting a dead
# target, reshuffling .PHONY). A hook that blocks on a guess trains people to
# pass --no-verify, which costs more than the occasional missed row.
removed_targets=$(git diff --cached -U0 -- Makefile \
    | grep -E '^-[a-zA-Z0-9_][a-zA-Z0-9_.-]*:' \
    | sed 's/^-//; s/:.*//' | sort -u | tr '\n' ' ')
if [ -n "$removed_targets" ] \
   && ! git diff --cached --name-only | grep -qx 'docs/language.md'; then
    echo "pre-commit: NOTE -- target(s) removed or renamed: $removed_targets"
    echo "            docs/language.md is NOT staged. If this is a rename of"
    echo "            something people type, add a row (Since, Commit, Use,"
    echo "            Instead of, Why) so the old name stays resolvable."
    echo "            The commit hash goes in AFTER this commit exists."
fi

# Run only the checks whose inputs are actually present. A commit that removes
# home/ or system/ has nothing for that half to check, and the Makefile globs
# would error rather than pass.
#
# Written as full if-blocks rather than `[ -d x ] && targets=...' because under
# `set -e' a trailing false test is itself a failing command, and the hook would
# abort with no output -- reading, from the outside, exactly like a pass.
targets=""
if [ -d "$tmp/home" ]; then
    targets="$targets check-session-coupling"
fi
if [ -d "$tmp/system" ]; then
    targets="$targets check-system"
fi

if [ -z "$targets" ]; then
    echo "pre-commit: neither home/ nor system/ in the staged tree, nothing to check"
    exit 0
fi

if make -C "$tmp" --no-print-directory $targets; then
    exit 0
else
    echo ""
    echo "pre-commit: BLOCKED. Fix the above, or bypass with --no-verify."
    exit 1
fi
