#!/bin/sh
# pinentry-auto -- the pinentry gpg-agent runs on macOS: a terminal prompt
# for an ssh session, the native pinentry-mac window otherwise.
#
# gpg-agent starts ONE pinentry program for every request, named in
# ~/.gnupg/gpg-agent.conf (rendered from gnupg/gpg-agent.mac.conf by
# `make install-gnupg').  pinentry-mac always opens a Cocoa window on the
# Mac's own display, so a `git commit' from an ssh login shows the dialog on
# a screen the user is not looking at and the commit sits there until it
# times out.  pinentry-curses draws in the requesting terminal instead, but
# cannot serve Emacs, GUI git clients or a background job with no tty.
#
# The agent's environment says nothing about the CLIENT, but gpg forwards the
# client's PINENTRY_USER_DATA to the pinentry it launches (gpg-agent(1),
# "pinentry-program"), so the shell decides: .zshrc.starship exports
# PINENTRY_USER_DATA=USE_TTY=1 when SSH_CONNECTION is set, and this script
# honours it.  The same variable can be set by hand to force a terminal
# prompt from a local shell:  PINENTRY_USER_DATA=USE_TTY=1 git commit
#
# --version and --help pass straight through, so `pinentry-auto --version'
# shows which program a plain (non-ssh) request would get.

find_pinentry() {
    # $1 = program name.  brew's prefix first (the agent's PATH may be the
    # bare launchd one), then whatever PATH has.
    for candidate in /opt/homebrew/bin/"$1" /usr/local/bin/"$1"; do
        if [ -x "$candidate" ]; then
            printf '%s\n' "$candidate"
            return 0
        fi
    done
    command -v "$1"
}

case "${PINENTRY_USER_DATA:-}" in
    *USE_TTY=1*)
        program=$(find_pinentry pinentry-curses) \
            || program=$(find_pinentry pinentry-tty)
        ;;
    *)
        program=$(find_pinentry pinentry-mac) \
            || program=$(find_pinentry pinentry-curses)
        ;;
esac

if [ -z "$program" ]; then
    echo "ERR 83886179 pinentry-auto: no pinentry-mac or pinentry-curses found (brew install pinentry-mac pinentry)" >&2
    exit 1
fi

exec "$program" "$@"
