#!/bin/sh
# pinentry-auto -- the pinentry gpg-agent runs on macOS: a terminal prompt
# for an ssh session, the native pinentry-mac window otherwise.
#
# gpg-agent starts ONE pinentry program for every request, named in
# ~/.gnupg/gpg-agent.conf (rendered from gnupg/gpg-agent.mac.conf by
# `make install-gnupg').  pinentry-mac always opens a Cocoa window on the
# Mac's own display, so a `git commit' from an ssh login shows the dialog on
# a screen the user is not looking at and the commit sits there until it
# times out.  pinentry-curses draws in the requesting terminal instead, but
# cannot serve Emacs, GUI git clients or a background job with no tty.
#
# The agent's environment says nothing about the CLIENT, but gpg forwards the
# client's PINENTRY_USER_DATA to the pinentry it launches (gpg-agent(1),
# "pinentry-program"), so the shell decides: .zshrc.starship exports
# PINENTRY_USER_DATA=USE_TTY=1 when SSH_CONNECTION is set, and this script
# honours it.  The same variable can be set by hand to force a terminal
# prompt from a local shell:  PINENTRY_USER_DATA=USE_TTY=1 git commit
#
# --version and --help pass straight through, so `pinentry-auto --version'
# shows which program a plain (non-ssh) request would get.
#
# Every prompt says WHOSE passphrase it wants.  Each machine has its own
# signing subkey with its own passphrase (machines.toml), and this hub's
# agent holds all of them, so a bare "unlock the OpenPGP secret key" left
# the user guessing between machine passwords.  gpg-agent describes each
# prompt with an Assuan `SETDESC <text>' line on the pinentry's stdin; the
# text carries the key's long ID ("ID 1FE5BBBC0A765369").  label_requests
# looks that ID up in machines.toml and puts a first line on the prompt:
#   Passphrase: framepop's signing key  (agent on minius)
#   Passphrase: MASTER key  (agent on minius)
# An ID it does not know gets "key <id>"; it never blocks the prompt.

find_pinentry() {
    # $1 = program name.  brew's prefix first (the agent's PATH may be the
    # bare launchd one), then whatever PATH has.
    for candidate in /opt/homebrew/bin/"$1" /usr/local/bin/"$1"; do
        if [ -x "$candidate" ]; then
            printf '%s\n' "$candidate"
            return 0
        fi
    done
    command -v "$1"
}

agent_host() {
    # macOS's LocalHostName (minius), else the short hostname.
    scutil --get LocalHostName 2>/dev/null || hostname -s 2>/dev/null || hostname
}

label_requests() {
    # Copy the agent's Assuan commands through unchanged except SETDESC, one
    # line at a time (fflush) because the conversation is interactive.
    # $1 = machines.toml (may be missing), $2 = this host's name.
    awk -v inventory="$1" -v host="$2" '
        BEGIN {
            # Long key ID (last 16 hex digits) -> machine, from lines like
            #   [machines.framepop]  signing_subkey = "890B...5369"
            while ((getline line < inventory) > 0) {
                if (match(line, /^\[machines\.[^]]+\]/))
                    machine = substr(line, 11, RLENGTH - 11)
                else if (line ~ /^(signing_subkey|existing_subkey_id) *= *"[0-9A-Fa-f]+"/) {
                    split(line, part, "\"")
                    owner[toupper(substr(part[2], length(part[2]) - 15))] = machine
                } else if (line ~ /^primary_fingerprint *= *"/) {
                    split(line, part, "\"")
                    primary = toupper(substr(part[2], length(part[2]) - 15))
                }
            }
            gsub(/%/, "%25", host)
        }
        /^SETDESC / {
            who = ""
            if (match($0, /ID (0x)?[0-9A-Fa-f]+/)) {
                id = substr($0, RSTART + 3, RLENGTH - 3)
                sub(/^0x/, "", id)
                id = toupper(id)
                if (id == primary)   who = "MASTER key"
                else if (id in owner) who = owner[id] "%27s signing key"
                else                 who = "key " id
            }
            if (who != "")
                sub(/^SETDESC /, "SETDESC Passphrase: " who "  (agent on " host ")%0A%0A")
        }
        { print; fflush() }'
}

case "${PINENTRY_USER_DATA:-}" in
    *USE_TTY=1*)
        # Ensure ncurses can resolve terminal types like xterm-ghostty when
        # gpg-agent was started with a minimal environment; otherwise
        # pinentry-curses fails in curses_init with "Screen or window too small".
        for tidir in \
            /Applications/Ghostty.app/Contents/Resources/terminfo \
            "$HOME/.terminfo" \
            /opt/homebrew/opt/ncurses/share/terminfo \
            /usr/local/opt/ncurses/share/terminfo \
            /usr/share/terminfo
        do
            if [ -d "$tidir" ]; then
                TERMINFO_DIRS="${TERMINFO_DIRS:+$TERMINFO_DIRS:}$tidir"
            fi
        done
        export TERMINFO_DIRS
        program=$(find_pinentry pinentry-curses) \
            || program=$(find_pinentry pinentry-tty)
        ;;
    *)
        program=$(find_pinentry pinentry-mac) \
            || program=$(find_pinentry pinentry-curses)
        ;;
esac

if [ -z "$program" ]; then
    echo "ERR 83886179 pinentry-auto: no pinentry-mac or pinentry-curses found (brew install pinentry-mac pinentry)" >&2
    exit 1
fi

case "${1:-}" in
    --version|--help)
        exec "$program" "$@"   # no Assuan session: nothing to label
        ;;
esac

# machines.toml sits at the top of dot_files, one level above bin/.  The
# pipeline's status is the pinentry's (the last command), which gpg-agent reads.
label_requests "$(dirname "$0")/../machines.toml" "$(agent_host)" | "$program" "$@"
