#!/bin/sh
# job-tee -- run a command, teeing stdout+stderr to ./logs/<task>.<timestamp>.log
#
# Usage: job-tee TASK CMD [ARGS...]
#
# The single log writer behind tmux-run, launchd-run and docker-run (see
# ~/dot_files/.jobs.zsh). Docker bind-mounts this same file read-only into the
# container, so a task's logs look identical whichever runner produced them.
# That is what lets `job-promote TASK` move a task between runners without
# renaming it or relocating its logs.
#
# Layout, relative to the working directory (the repo root):
#   logs/TASK.YYYYmmdd-HHMMSS.log   one file per run: header, output, exit footer
#   logs/TASK.latest.log            relative symlink to the newest run
#
# Two promises beyond "tee the output", both of them about never losing the
# record of a run. Stage 08 measured both of them broken against a real engine
# (docs/stages/stage-08-REPORT.md, Q3 and Q2):
#
#   * Every run that starts gets an exit footer -- including one ended by
#     TERM, INT or HUP. The signal is forwarded to the command, the command is
#     waited for, and the footer records 128+signal: the same number the
#     runner's own accounting reports (podman `inspect .State.ExitCode',
#     tmux `#{pane_dead_status}'). Before this, a `docker-stop' left a log with
#     a beginning and no end and the job's 143 lived only in the engine.
#     SIGKILL remains the documented exception -- nothing can trap it.
#
#   * A run that cannot be recorded does not happen. The log file and the
#     `latest' symlink are proved writable BEFORE the command starts; if they
#     are not, job-tee names the path and the uid on stderr and exits 1 having
#     run nothing. Before this, a container promoted to a non-root USER ran the
#     command, wrote no log, and reported 0 all the way out -- a job that
#     looked perfect and kept no evidence of having happened.
#
# Deliberately POSIX sh: it has to run under /bin/sh in minimal images
# (debian:stable-slim's is dash).
set -u

usage() { echo "usage: job-tee TASK CMD [ARGS...]" >&2; exit 64; }
[ $# -ge 2 ] || usage
task=$1; shift
case $task in
  ''|*[!A-Za-z0-9_-]*) echo "job-tee: task must match [A-Za-z0-9_-]+, got '$task'" >&2; exit 64 ;;
esac
cmdstr=$*
uid=$(id -u 2>/dev/null) || uid='?'

# ---------------------------------------------------------------------------
# Refuse to run unrecorded
# ---------------------------------------------------------------------------
# One line, on the real stderr, naming the path that could not be written and
# the uid that could not write it -- those two facts together are the whole
# diagnosis, and the uid is the one that is impossible to guess from outside a
# container. Exit 1 rather than proceeding: the runner verbs exist to produce
# accountable jobs, and an exit 1 is visible in `docker-status' /
# `podman inspect .State.ExitCode' where the silent 0 was not.

refuse() {
  printf 'job-tee: cannot write %s (uid %s): refusing to run unrecorded: %s\n' \
    "$1" "$uid" "$cmdstr" >&2
  exit 1
}

log_dir=${JOB_LOG_DIR:-logs}
mkdir -p "$log_dir" 2>/dev/null || refuse "$log_dir"
stamp=$(date +%Y%m%d-%H%M%S)
log="$log_dir/$task.$stamp.log"
latest="$log_dir/$task.latest.log"

# The probes are the real operations, not guesses about them: an append to the
# log file and the symlink itself. `: >>' runs in a subshell because a
# redirection error on a special built-in exits the shell it happens in, which
# would take the diagnostic with it.
( : >>"$log" ) 2>/dev/null || refuse "$log"
ln -sfn "$task.$stamp.log" "$latest" 2>/dev/null || refuse "$latest"

# ---------------------------------------------------------------------------
# The recording channel
# ---------------------------------------------------------------------------
# The old shape was `{ header; "$@"; footer; } | tee -a "$log"'. The command
# ran inside a pipeline subshell, so this shell could neither learn its pid nor
# reach it with a signal, and a TERM killed that subshell where it stood --
# taking the footer with it. A fifo moves tee off the pipeline: this shell's
# own stdout and stderr become the log channel, the command becomes a
# background job of THIS shell, and a trap here can therefore forward a signal
# to the command AND still be alive afterwards to write the footer.
#
# The two opens rendezvous: tee's `<"$fifo"' blocks until a writer appears and
# the `exec >"$fifo"' blocks until a reader does. Neither can hang alone, and
# tee cannot die early for lack of a writable log because that was just proved
# above.

fifo="${TMPDIR:-/tmp}/job-tee.$$.fifo"
# The INT-escalation watchdog further down answers through a flag file rather
# than through an exit status: it must be able to say "I sent the TERM" without
# racing the main shell's decision to stop waiting for it. It lives next to the
# fifo because that directory has just been proved writable by the mkfifo.
esc_flag="$fifo.escalated"
rm -f "$fifo" "$esc_flag" 2>/dev/null
mkfifo -m 600 "$fifo" 2>/dev/null || refuse "$fifo"
trap 'rm -f "$fifo" "$esc_flag"' EXIT

exec 3>&1 4>&2                       # the real stdout/stderr, kept for the exit
tee -a "$log" <"$fifo" &
tee_pid=$!
exec >"$fifo" 2>&1

# The footer format is a parser contract, not cosmetics: tests/jobs/smoke.zsh
# scrapes `^== job-tee exit <spaces><digits>' and tests/jobs/podman-live.zsh
# asserts the literal prefix `== job-tee exit   0 at '. Status and timestamp
# therefore keep their exact columns and any extra detail goes in a trailing
# annotation, where a parser that does not know about it reads past it.
footer() { printf '\n== job-tee exit   %s at %s%s\n' "$1" "$(date '+%Y-%m-%d %H:%M:%S %z')" "$2"; }

# Closing this shell's write end is what tells tee the log is finished, so it
# has to happen before the exit, and tee has to be waited for: exiting first
# would race the last lines of the log out of existence.
finish() {
  exec >&3 2>&4
  wait "$tee_pid" 2>/dev/null
  rm -f "$fifo" "$esc_flag" 2>/dev/null
  exit "$1"
}

# ---------------------------------------------------------------------------
# Signals
# ---------------------------------------------------------------------------
# Forward, wait, record, exit -- in that order. Waiting is the point: the
# command may have its own TERM handler with cleanup to do, and a footer
# written before it finished would be a lie about when the job ended.
#
# The status recorded is 128+signal, because that is what the runner above
# reports for the same event and the two accounts have to agree. When the
# command answered the signal with an exit status of its own (a trap that
# exits 5) that number would otherwise be lost, so it rides along in the
# annotation instead of replacing anything.
#
# INT alone also ESCALATES. On several of the shells this script runs under,
# the command cannot receive a forwarded INT at all -- the long note at the
# async start below has the measurements, docs/LEARNINGS.md (2026-09-19) has
# the decision. "Forward and wait" on such a host waits for a death that never
# comes, and the run then ends by the runner's own SIGKILL with NO FOOTER,
# which is the single outcome this whole file exists to prevent. So an INT
# that the command did not act on within a bounded grace is followed by a
# TERM, which no shell ignores and every one of these shells delivers, and the
# footer's annotation says that is what happened.

# Seconds from the forwarded INT to the TERM behind it. It has to stay well
# under a container engine's stop timeout -- Docker's default is 10 s from the
# stop signal to SIGKILL -- because the whole sequence has to finish inside
# that window: this grace, THEN the command's own TERM handling, then tee
# draining and the footer. 2 s leaves 8 s of the 10 for the parts that are not
# this script's to spend.
INT_ESCALATION_GRACE=2

signalled=0

# Why the grace is a background watchdog and not a poll in the handler: the
# handler must `wait' for the command (that is how the command's own exit
# status is learned, and waiting reaps it), and a `kill -0' poll run by a shell
# that has NOT yet waited is blind -- an unreaped child is a zombie, and a
# zombie answers `kill -0' exactly like a live process, so such a poll would
# report "still alive" and escalate every single time, including when the INT
# worked perfectly. With the handler blocked in `wait', the child is reaped the
# instant it dies, and the watchdog's `kill -0' becomes a truthful liveness
# test.
escalation_watchdog() {
  # Poll granularity: a tenth of a second where the userland has one --
  # measured accepted, and really sub-second, by macOS /bin/sh (bash 3.2),
  # debian:stable-slim's dash and alpine's busybox ash (stage 13, Q1) -- and
  # whole seconds where `sleep 0.1' is rejected, so a coarser userland gets a
  # coarser grace rather than a grace that collapses to nothing.
  if sleep 0.1 2>/dev/null; then
    tick=0.1; ticks=$(( INT_ESCALATION_GRACE * 10 ))
  else
    tick=1;   ticks=$INT_ESCALATION_GRACE
  fi
  i=0
  while [ "$i" -lt "$ticks" ]; do
    kill -0 "$cmd_pid" 2>/dev/null || return 0     # the INT was enough
    sleep "$tick"
    i=$(( i + 1 ))
  done
  kill -0 "$cmd_pid" 2>/dev/null || return 0
  # Flag first, signal second: the handler must never be able to read "not
  # escalated" about a TERM that has in fact been sent.
  : >"$esc_flag" 2>/dev/null
  kill -s TERM "$cmd_pid" 2>/dev/null
}

on_signal() {
  name=$1
  num=$2
  [ "$signalled" -eq 0 ] || return 0
  signalled=1
  status=$(( 128 + num ))
  cmd_status=$status
  escalated=no
  if [ -n "${cmd_pid:-}" ]; then
    kill -s "$name" "$cmd_pid" 2>/dev/null
    if [ "$name" = INT ]; then
      # `>/dev/null 2>&1' is not cosmetic: a background job inherits this
      # shell's stdout, which IS the fifo, and tee only learns the log has
      # ended when the last writer closes it. A watchdog still holding that
      # write end would stall `finish' for the length of the grace.
      escalation_watchdog >/dev/null 2>&1 &
      watchdog_pid=$!
      wait "$cmd_pid" 2>/dev/null
      cmd_status=$?
      kill -s TERM "$watchdog_pid" 2>/dev/null   # a no-op if it already ran
      wait "$watchdog_pid" 2>/dev/null
      [ -f "$esc_flag" ] && escalated=yes
    else
      wait "$cmd_pid" 2>/dev/null
      cmd_status=$?
    fi
  fi
  if [ "$escalated" = yes ]; then
    footer "$status" \
      " (SIG$name; escalated to SIGTERM after ${INT_ESCALATION_GRACE}s; command exited $cmd_status)"
  elif [ "$cmd_status" -eq "$status" ]; then
    footer "$status" " (SIG$name)"
  else
    footer "$status" " (SIG$name; command exited $cmd_status)"
  fi
  finish "$status"
}

trap 'on_signal TERM 15' TERM
trap 'on_signal INT 2'   INT
trap 'on_signal HUP 1'   HUP

printf '== job-tee start  %s\n' "$(date '+%Y-%m-%d %H:%M:%S %z')"
printf '== task           %s\n' "$task"
printf '== runner         %s\n' "${JOB_RUNNER:-shell}"
printf '== cwd            %s\n' "$PWD"
printf '== cmd            %s\n\n' "$cmdstr"

# Two things in this line exist only because the command is started
# asynchronously, which POSIX gives a signal environment of its own:
#
#   * `trap - INT QUIT' -- a shell without job control sets SIGINT and SIGQUIT
#     to SIG_IGN in the children of an asynchronous list. Without the reset the
#     command IGNORES a forwarded INT, the handler below waits for a death that
#     never comes, and job-tee hangs where it used to die. Measured under this
#     host's sh (bash 5.2.37 as sh), before the reset:
#       $ sh -c 'sh -c "trap -p" & wait' | grep INT
#       trap -- '' INT
#     and after it, in the same async subshell: `trap -- - INT'. The subshell
#     exists purely to hold the reset; `exec' then puts the real command in its
#     place, so $! is still the command's own pid and no shell is left over it.
#
#     It does NOT work everywhere, and the difference is measured, not assumed.
#     At least two host classes enforce the POSIX rule that an ignored signal
#     cannot be un-ignored:
#
#       - dash -- debian:stable-slim's /bin/sh, so the shell for every docker
#         job:
#           # in debian:stable-slim
#           mode=plain     -> INT IGNORED (child survived)
#           mode=subshell  -> INT IGNORED (child survived)
#
#       - macOS's /bin/sh, which is bash 3.2.57(1)-release. Measured on macOS 27
#         in stage 12, sending the INT only once the child had exec'd the sleep:
#           /bin/sh                3.2.57(1)-release    SURVIVED
#           /bin/dash              dash                 SURVIVED
#           /opt/homebrew/bin/bash 5.3.15(1)-release    DIED
#         so it is bash 3.2's behaviour rather than Darwin's: a bash 5 on the
#         same machine grants the reset, which is why the Guix measurement above
#         (bash 5.2.37 as sh) sees `trap -- - INT'.
#
#     So on such a host a forwarded INT reaches a command that cannot act on it.
#     TERM and HUP -- what docker-stop, launchd and `tmux kill-window' actually
#     send -- are not in POSIX's ignore set and are unaffected; and a Ctrl-C in
#     a tmux pane is delivered by the kernel to the whole foreground process
#     group, so the command gets it directly whatever job-tee does. What was
#     left uncovered is a deliberate `kill -INT <job-tee-pid>' on those hosts,
#     plus the realistic version of it: an image whose STOPSIGNAL is SIGINT, so
#     `docker-stop' sends INT and the engine's 10 s timer ends the run with
#     SIGKILL and no footer.
#
#     Since stage 13 the handler above does not depend on the reset working: an
#     INT the command has not acted on within INT_ESCALATION_GRACE is followed
#     by a TERM, and the footer records `escalated to SIGTERM'. Turning job
#     control on was measured as the alternative and rejected -- it needs a
#     controlling terminal that a detached container does not have, writes job
#     notices into the log, and moves the child out of the foreground process
#     group (docs/LEARNINGS.md, 2026-09-19). This script therefore never
#     enables job control. The reset stays because where it IS
#     honoured the command gets the real INT and the escalation never fires.
#     tests/jobs/tee-smoke.zsh section 5 still probes the local /bin/sh with
#     this very construct -- the probe is the explanation of which branch a host
#     takes -- but the INT assertions themselves now run on every host, and
#     section 5c proves the escalation inside dash and busybox ash.
#
#   * `<&0' -- POSIX assigns /dev/null to the standard input of an asynchronous
#     list unless the redirection is explicit, and a job that could read its
#     caller's stdin before this change should still be able to.
( trap - INT QUIT; exec "$@" ) <&0 &
cmd_pid=$!
wait "$cmd_pid"
rc=$?
footer "$rc" ""
finish "$rc"
