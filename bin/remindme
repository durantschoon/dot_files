#!/bin/sh
#
# bin/remindme -- view and manage personal markdown reminder sheets with glow.
#
# Reminders live in the private submodule at ~/dot_files/remindme/private
# (override with REMINDME_DIR).
#
# Usage:
#   remindme <topic>          Render <topic>.md with glow
#   remindme -p <topic>       Render <topic>.md with glow --pager
#   remindme -e <topic>       Create or edit <topic>.md in $EDITOR
#   remindme -l, --list       List available reminder topics
#   remindme -s <pattern>     Search across reminder files
#   remindme --path [<topic>] Print the directory or topic file path
#   remindme -c <topic> <N>   Copy the code blocks of section N to the clipboard
#   remindme -r <topic> <N>   Print the code blocks of section N, verbatim
#   remindme                  Open glow's interactive TUI in REMINDME_DIR

set -u

PROG=remindme
REMINDME_DIR=${REMINDME_DIR:-"$HOME/dot_files/remindme/private"}
REMINDME_GLOW_STYLE=${REMINDME_GLOW_STYLE:-dark}

die() {
    printf '%s: %s\n' "$PROG" "$*" >&2
    exit 1
}

usage() {
    cat <<EOF
usage: $PROG [options] [<topic>]

View and manage markdown reminder sheets in:
  $REMINDME_DIR

Options:
  -p, --pager           Display with glow's pager (-p)
  -e, --edit <topic>    Create or edit <topic>.md in \${VISUAL:-\${EDITOR:-vi}}
  -l, --list            List available reminder topics
  -s, --search <regex>  Search inside all reminder sheets
      --path [<topic>]  Print REMINDME_DIR or the path to <topic>.md
  -c, --copy <topic> <N>
                        Copy the code blocks of section N (the "## N." heading)
                        to the clipboard, exactly as written: no indentation,
                        no wrapping. Without N, list the numbered sections.
  -r, --raw <topic> <N> The same, printed to stdout
  -h, --help            Show this help message
EOF
}

strip_md() {
    case $1 in
        *.md) printf '%s\n' "${1%.md}" ;;
        *)    printf '%s\n' "$1" ;;
    esac
}

has_notes() {
    [ -d "$REMINDME_DIR" ] || return 1
    for f in "$REMINDME_DIR"/*.md; do
        [ -f "$f" ] || continue
        case ${f##*/} in
            README.md) continue ;;
        esac
        return 0
    done
    return 1
}

check_initialized() {
    if [ ! -d "$REMINDME_DIR" ] || { [ ! -e "$REMINDME_DIR/.git" ] && ! has_notes; }; then
        cat >&2 <<EOF
$PROG: no reminders found in $REMINDME_DIR
If the private submodule is not initialized yet, run:
  git -C ~/dot_files submodule update --init remindme/private
or create one with:
  $PROG -e <topic>
EOF
        return 1
    fi
    return 0
}

list_topics() {
    check_initialized || exit 1
    found=0
    for f in "$REMINDME_DIR"/*.md; do
        [ -f "$f" ] || continue
        base=${f##*/}
        [ "$base" = "README.md" ] && continue
        topic=${base%.md}
        title=$(sed -n 's/^#[[:space:]]\{1,\}//p' "$f" | head -n 1)
        if [ -n "$title" ]; then
            printf '%-20s %s\n' "$topic" "$title"
        else
            printf '%s\n' "$topic"
        fi
        found=1
    done
    if [ "$found" -eq 0 ]; then
        printf '%s: no reminder sheets in %s (create one with: %s -e <topic>)\n' \
            "$PROG" "$REMINDME_DIR" "$PROG" >&2
        exit 1
    fi
}

# The numbered sections of a sheet: its "## N. title" headings.
list_sections() {
    printf 'Sections in %s:\n' "$(strip_md "${1##*/}")" >&2
    sed -n 's/^##[[:space:]]\{1,\}\([0-9]\{1,\}\.\)/  \1/p' "$1" >&2
}

# section_code FILE N: the fenced code blocks under "## N." up to the next
# "## " heading, verbatim, one blank line between blocks. What glow shows is
# indented and wrapped to the terminal, so a block copied off the screen is
# not the block in the file; this is. Exit 2: no such section; 3: no code.
section_code() {
    awk -v n="$2" '
        /^##[ \t]/ && !/^###/ {
            head = $0; sub(/^##[ \t]+/, "", head)
            insec = (index(head, n ".") == 1)
            if (insec) found = 1
            next
        }
        !insec { next }
        /^[ \t]*```/ {
            if (infence) { infence = 0 } else { infence = 1; if (blocks++) print "" }
            next
        }
        infence { print }
        END { if (!found) exit 2; if (!blocks) exit 3 }
    ' "$1"
}

# Write stdin to the system clipboard with whatever this machine has.
copy_to_clipboard() {
    if command -v pbcopy >/dev/null 2>&1; then pbcopy
    elif [ -n "${WAYLAND_DISPLAY:-}" ] && command -v wl-copy >/dev/null 2>&1; then wl-copy
    elif [ -n "${DISPLAY:-}" ] && command -v xclip >/dev/null 2>&1; then xclip -selection clipboard
    elif [ -n "${DISPLAY:-}" ] && command -v xsel >/dev/null 2>&1; then xsel --clipboard --input
    elif [ -n "${TMUX:-}" ] && command -v tmux >/dev/null 2>&1; then tmux load-buffer -w -
    else return 1
    fi
}

render_file() {
    file=$1
    pager_flag=$2
    if command -v glow >/dev/null 2>&1; then
        if [ -n "$pager_flag" ]; then
            exec glow -s "$REMINDME_GLOW_STYLE" -p "$file"
        else
            exec glow -s "$REMINDME_GLOW_STYLE" "$file"
        fi
    else
        printf '%s: warning: glow not found on PATH; falling back to cat\n' "$PROG" >&2
        exec cat "$file"
    fi
}

pager_flag=''
action='view'
arg=''
section=''

while [ $# -gt 0 ]; do
    case $1 in
        -h|--help)
            usage
            exit 0
            ;;
        -l|--list)
            action='list'
            shift
            ;;
        -p|--pager)
            pager_flag='-p'
            shift
            ;;
        -e|--edit)
            [ $# -ge 2 ] || die "$1 requires a <topic> argument"
            action='edit'
            arg=$2
            shift 2
            ;;
        -s|--search)
            [ $# -ge 2 ] || die "$1 requires a <pattern> argument"
            action='search'
            arg=$2
            shift 2
            ;;
        -c|--copy)
            action='copy'
            shift
            ;;
        -r|--raw)
            action='raw'
            shift
            ;;
        --path)
            action='path'
            if [ $# -ge 2 ]; then
                arg=$2
                shift 2
            else
                shift
            fi
            ;;
        --)
            shift
            break
            ;;
        -*)
            die "unknown option: $1 (try '$PROG --help')"
            ;;
        *)
            if [ -z "$arg" ]; then
                arg=$1
            elif [ -z "$section" ]; then
                section=$1
            else
                die "unexpected argument: $1"
            fi
            shift
            ;;
    esac
done

if [ -z "$arg" ] && [ $# -gt 0 ]; then
    arg=$1
fi

# A second positional argument is a section number, which only --copy and
# --raw take.
case $action in
    copy|raw) ;;
    *) [ -z "$section" ] || die "unexpected argument: $section" ;;
esac

case $action in
    copy|raw)
        [ -n "$arg" ] || die "--$action requires a <topic> (and a section number)"
        topic=$(strip_md "$arg")
        target="$REMINDME_DIR/$topic.md"
        [ -f "$target" ] || die "no reminder named '$topic' ($target)"
        if [ -z "$section" ]; then
            list_sections "$target"
            printf '%s: give a section number, e.g. %s --%s %s 1\n' "$PROG" "$PROG" "$action" "$topic" >&2
            exit 1
        fi
        case $section in
            *[!0-9]*) die "section must be a number, got '$section'" ;;
        esac
        code=$(section_code "$target" "$section")
        rc=$?
        if [ "$rc" -eq 2 ]; then list_sections "$target"; die "no section $section in $topic"; fi
        [ "$rc" -eq 3 ] && die "section $section of $topic has no code blocks"
        if [ "$action" = raw ]; then
            printf '%s\n' "$code"
        else
            printf '%s\n' "$code" | copy_to_clipboard \
                || die "no clipboard tool found (pbcopy, wl-copy, xclip, xsel or tmux); use --raw"
            printf '%s: copied %s line(s) from section %s of %s\n' \
                "$PROG" "$(printf '%s\n' "$code" | wc -l | tr -d ' ')" "$section" "$topic" >&2
        fi
        ;;
    list)
        list_topics
        ;;
    path)
        if [ -n "$arg" ]; then
            topic=$(strip_md "$arg")
            printf '%s/%s.md\n' "$REMINDME_DIR" "$topic"
        else
            printf '%s\n' "$REMINDME_DIR"
        fi
        ;;
    edit)
        topic=$(strip_md "$arg")
        [ -n "$topic" ] || die "empty topic name"
        mkdir -p "$REMINDME_DIR" || die "cannot create $REMINDME_DIR"
        editor=${EDITOR:-${VISUAL:-vi}}
        # Intentional word-splitting so EDITOR="emacsclient -c -a \"\"" works
        eval "$editor \"\$REMINDME_DIR/\$topic.md\""
        ;;
    search)
        check_initialized || exit 1
        if command -v rg >/dev/null 2>&1; then
            exec rg -n --glob '*.md' --glob '!README.md' -- "$arg" "$REMINDME_DIR"
        else
            exec grep -rn --include='*.md' --exclude='README.md' -- "$arg" "$REMINDME_DIR"
        fi
        ;;
    view)
        if [ -z "$arg" ]; then
            check_initialized || exit 1
            if [ -t 1 ] && command -v glow >/dev/null 2>&1; then
                exec glow "$REMINDME_DIR"
            else
                list_topics
            fi
        else
            topic=$(strip_md "$arg")
            target="$REMINDME_DIR/$topic.md"
            if [ ! -f "$target" ]; then
                check_initialized || exit 1
                printf '%s: no reminder named '\''%s'\'' (%s)\n' "$PROG" "$topic" "$target" >&2
                if has_notes; then
                    printf '\nAvailable reminders:\n' >&2
                    list_topics | sed 's/^/  /' >&2
                fi
                exit 1
            fi
            render_file "$target" "$pager_flag"
        fi
        ;;
esac
