#!/usr/bin/env bash
#
# git-safe-to-delete -- can this clone be deleted and re-cloned from origin
# without losing anything?
#
# On PATH as `git safe-to-delete` (~/bin -> ~/dot_files/bin).
#
#   git safe-to-delete                  # check the current repo + its submodules
#   git safe-to-delete ~/a ~/b ~/c      # check several checkouts at once
#   git safe-to-delete --no-fetch       # skip the network round trip
#   git safe-to-delete --no-recurse     # top-level repo only, skip submodules
#   git safe-to-delete --quiet          # verdict lines only, for scripting
#
# WHY: after upstream history is rewritten, deleting the clone and re-cloning
# is cleaner than resetting it in place -- a fresh clone never receives the old
# objects at all, so there is no reflog to expire and no gc to trust. See
# git-resync-rewrite for the in-place version and why it is harder to get right.
#
# But "just re-clone" is only safe if nothing lives ONLY in this directory.
# Four things routinely do, and `git status` shows none of them by default:
#
#   unpushed commits    on any branch, not just the checked-out one
#   stash entries       invisible to status, destroyed with .git
#   local-only branches and tags that were never pushed
#   ignored files       machine-specific config, credentials, env files --
#                       the ones that matter most in a dotfiles repo, and the
#                       ones `git status` hides hardest
#
# BOOTSTRAPPING A STALE CLONE: this script lives in the repo it evaluates, so
# the machine most in need of it is the one whose clone is too old to have it.
# Do NOT pull to get it -- a pull is a merge, it can conflict, and it dirties
# the very tree this script is about to judge (a modified file reads as "not on
# origin" and turns the verdict into STOP). Fetch the blob and read it straight
# out of the object store instead:
#
#   cd ~/dot_files
#   git fetch origin
#   git show origin/main:bin/git-safe-to-delete > /tmp/std.sh
#   bash /tmp/std.sh ~/dot_files
#
# `git show` writes nothing into the worktree, so the clone is left exactly as
# it was found -- which is the point, since its untouched state is the thing
# being measured. git-resync-rewrite carries the same note for the same reason.
#
# NOTE ON STASHES, the finding this most often turns up: a stash cannot be
# pushed. There is no remote ref for it, so re-cloning loses it however clean
# everything else is. Carry it across as a patch, or promote it to real history:
#
#   git stash show -p stash@{0} > ~/keep.patch     # re-apply after re-cloning
#   git stash branch salvage-stash stash@{0}       # then push the branch
#
# SUBMODULES are checked too, recursively, and are on by default: deleting the
# superproject deletes their working trees and their .git/modules along with it,
# so an unpushed commit inside a submodule is lost just as thoroughly as one in
# the parent -- and `git status` in the parent reports at most a bare "modified:
# <path> (new commits)", which reads like a version bump rather than data loss.
# An uninitialised submodule is reported and skipped: there is no working tree,
# so it holds nothing that a re-clone would not restore.
#
# EXIT STATUS
#   0  safe: re-cloning loses nothing
#   1  review: something is here that origin does not have
#   2  usage error, or a path that is not a git repository

set -uo pipefail

FETCH=1
QUIET=0
RECURSE=1
REMOTE=origin

# Prepended to every line, so nested submodules indent under their parent.
PREFIX=""

die() { printf '%s\n' "$*" >&2; exit 2; }
say() { [[ $QUIET -eq 1 ]] || printf '%s%s\n' "$PREFIX" "$*"; }

targets=()
while [[ $# -gt 0 ]]; do
    case "$1" in
        --no-fetch)                     FETCH=0 ;;
        --quiet|-q)                     QUIET=1 ;;
        --no-recurse|--no-recurse-submodules) RECURSE=0 ;;
        --recurse|--recurse-submodules) RECURSE=1 ;;
        --remote)     REMOTE="${2:?--remote needs a name}"; shift ;;
        # Print the whole leading comment block, however long it grows, rather
        # than a hardcoded line range that silently truncates when it does.
        -h|--help)    sed -n '2,/^$/p' "$0" | sed 's/^# \{0,1\}//'; exit 0 ;;
        -*)           die "unknown option: $1 (try --help)" ;;
        *)            targets+=("$1") ;;
    esac
    shift
done
[[ ${#targets[@]} -gt 0 ]] || targets=(.)

# Check one repository. Echoes findings, returns 0 if safe.
#
# Everything uses `git -C` rather than cd, so a failure partway through cannot
# leave the caller in a different directory than it started in.
check_repo() {
    local dir="$1" problems=0 warnings=0 out root

    git -C "$dir" rev-parse --git-dir >/dev/null 2>&1 \
        || { say "  !! not a git repository"; return 2; }
    root=$(git -C "$dir" rev-parse --show-toplevel 2>/dev/null)

    # No remote means there is nothing to re-clone FROM -- the most important
    # check, and the easiest to forget, since such a repo looks perfectly
    # healthy until the moment it is gone.
    if ! git -C "$dir" remote get-url "$REMOTE" >/dev/null 2>&1; then
        say "  !! no remote named '$REMOTE' -- nothing to re-clone from"
        return 1
    fi

    if [[ $FETCH -eq 1 ]]; then
        git -C "$dir" fetch --prune --tags --quiet "$REMOTE" 2>/dev/null \
            || say "  ?? fetch failed -- results below may be stale"
    fi

    # Commits that no remote-tracking ref contains.
    #
    # --branches covers every branch, not just the checked-out one; a plain
    # `git status` says nothing about the branch you are not standing on.
    #
    # HEAD is listed as well, and is not redundant: a submodule is checked out
    # at a DETACHED HEAD by default, so a commit made inside one belongs to no
    # branch and --branches alone cannot see it. Without HEAD here a submodule
    # holding real unpushed work reported "safe to delete" -- observed while
    # testing recursion, 2026-08-16.
    out=$(git -C "$dir" log HEAD --branches --not --remotes --oneline 2>/dev/null | head -20)
    if [[ -n "$out" ]]; then
        say "  !! unpushed commits:"
        printf '%s\n' "$out" | sed "s/^/${PREFIX}       /"
        problems=$((problems + 1))
    fi

    # Stashes live in refs/stash, are not part of any branch, and are deleted
    # with the directory. Nothing about `git status` hints they exist.
    out=$(git -C "$dir" stash list 2>/dev/null)
    if [[ -n "$out" ]]; then
        say "  !! stash entries ($(printf '%s\n' "$out" | wc -l | tr -d ' ')):"
        printf '%s\n' "$out" | head -10 | sed "s/^/${PREFIX}       /"
        problems=$((problems + 1))
    fi

    # Branches with no upstream. Their commits may well be pushed under some
    # other ref, so this is not covered by the unpushed-commits check above --
    # what is lost is the branch NAME and its position.
    out=$(git -C "$dir" for-each-ref --format='%(refname:short) %(upstream)' refs/heads 2>/dev/null \
          | awk '$2 == "" { print $1 }')
    if [[ -n "$out" ]]; then
        say "  !! branches with no upstream:"
        printf '%s\n' "$out" | head -10 | sed "s/^/${PREFIX}       /"
        problems=$((problems + 1))
    fi

    # Tags that exist here but not on the remote. `git push` does not push tags
    # by default, so local-only tags are common and easy to lose.
    if [[ $FETCH -eq 1 ]]; then
        out=$(comm -23 \
                <(git -C "$dir" tag | sort) \
                <(git -C "$dir" ls-remote --tags "$REMOTE" 2>/dev/null \
                  | awk '{print $2}' | sed 's|refs/tags/||; s|\^{}$||' | sort -u) 2>/dev/null)
        if [[ -n "$out" ]]; then
            say "  !! tags not on $REMOTE:"
            printf '%s\n' "$out" | head -10 | sed "s/^/${PREFIX}       /"
            problems=$((problems + 1))
        fi
    fi

    # Linked worktrees are separate directories whose administrative files live
    # in this .git. Deleting this repo breaks them, wherever they are.
    out=$(git -C "$dir" worktree list 2>/dev/null | tail -n +2)
    if [[ -n "$out" ]]; then
        say "  !! linked worktrees (deleting this repo breaks them):"
        printf '%s\n' "$out" | sed "s/^/${PREFIX}       /"
        problems=$((problems + 1))
    fi

    # Uncommitted modifications to tracked files.
    out=$(git -C "$dir" status --porcelain 2>/dev/null | grep -v '^??')
    if [[ -n "$out" ]]; then
        say "  !! uncommitted changes:"
        printf '%s\n' "$out" | head -10 | sed "s/^/${PREFIX}       /"
        problems=$((problems + 1))
    fi

    # Untracked and ignored files, reported together but only as a warning:
    # they are frequently build output, and frequently the local config that is
    # the entire point of the directory. This script cannot tell which, so it
    # shows them and leaves the judgement to a human. In a dotfiles repo the
    # ignored list is the one to actually read.
    out=$(git -C "$dir" status --porcelain -uall --ignored=matching 2>/dev/null \
          | grep -E '^(\?\?|!!)')
    if [[ -n "$out" ]]; then
        say "  ?? untracked/ignored files ($(printf '%s\n' "$out" | wc -l | tr -d ' ')) -- read before deleting:"
        printf '%s\n' "$out" | head -12 | sed "s/^/${PREFIX}       /"
        [[ $(printf '%s\n' "$out" | wc -l) -gt 12 ]] && say "       ... (git -C $root status --porcelain -uall --ignored=matching)"
        warnings=$((warnings + 1))
    fi

    if [[ $problems -gt 0 ]]; then
        return 1
    elif [[ $warnings -gt 0 ]]; then
        return 3          # safe apart from files a human should eyeball
    fi
    return 0
}

overall=0

# Fold one repository's verdict into the run-wide exit status.
#
# 2 (bad path / not a repo) outranks everything: a caller scripting this must
# not read "I could not look" as "I looked and found nothing".
n_ok=0; n_warn=0; n_stop=0; n_bad=0

record() {
    case "$1" in
        0) say "  OK   safe to delete and re-clone"; n_ok=$((n_ok + 1)) ;;
        3) say "  WARN safe as far as git is concerned; check the files above first"
           n_warn=$((n_warn + 1)); [[ $overall -eq 0 ]] && overall=1 ;;
        2) n_bad=$((n_bad + 1)); overall=2 ;;
        *) say "  STOP something here is not on $REMOTE"
           n_stop=$((n_stop + 1)); [[ $overall -ne 2 ]] && overall=1 ;;
    esac
}

# Direct submodule paths of $1, one per line.
#
# Read from `submodule status` rather than .gitmodules because .gitmodules also
# lists submodules that were never initialised -- those have no working tree and
# so cannot hold anything a re-clone would not restore. The leading status
# character and the trailing "(describe)" are stripped; whatever remains is the
# path, which keeps working for paths containing spaces.
submodule_paths() {
    git -C "$1" submodule status 2>/dev/null \
        | sed -e 's/^.//' -e 's/^[0-9a-f]\{7,40\} //' -e 's/ ([^)]*)$//'
}

# Check $1, then every submodule beneath it, indenting each level.
check_tree() {
    local dir="$1" sub subdir saved_prefix rc

    check_repo "$dir"; rc=$?
    record "$rc"

    # A directory that is not a repository has no submodules to walk, and a
    # repo whose own check could not run tells us nothing about its children.
    [[ $RECURSE -eq 1 && $rc -ne 2 ]] || return 0

    saved_prefix="$PREFIX"
    while IFS= read -r sub; do
        [[ -n "$sub" ]] || continue
        subdir="$dir/$sub"
        PREFIX="$saved_prefix    "
        say ""
        say "-- submodule: $sub"
        if [[ -e "$subdir/.git" ]]; then
            check_tree "$subdir"
        else
            # Configured but never `submodule update --init`: nothing local to
            # lose, so this is neither a problem nor a warning.
            say "  --   not initialised, nothing local to lose"
        fi
        PREFIX="$saved_prefix"
    done < <(submodule_paths "$dir")
}

for t in "${targets[@]}"; do
    # A path that does not exist is the same class of caller error as a path
    # that is not a repository, so it gets exit 2 rather than 1.
    abs=$(cd "$t" 2>/dev/null && pwd) || { say "== $t"; say "  !! no such directory"; overall=2; continue; }
    say "== $abs"
    check_tree "$abs"
    say ""
done

# A per-repo verdict is easy to skim past when a clean superproject is listed
# above a submodule that is not clean, so restate the run as one line. The
# counts include submodules -- each is independently deletable or not.
PREFIX=""
say "== summary: $n_ok ok, $n_warn warn, $n_stop stop, $n_bad unreadable"
if [[ $n_stop -eq 0 && $n_bad -eq 0 && $n_warn -eq 0 ]]; then
    say "   nothing here is missing from $REMOTE -- safe to delete and re-clone"
else
    say "   do NOT delete until the STOP/WARN entries above are dealt with"
fi

exit $overall
