#!/usr/bin/env python3
"""shared-dirs -- which of this machine's directories another machine also sees.

usage: shared-dirs                 print this machine's shared directories, one per line
       shared-dirs --with          print the machine(s) it shares them with
       shared-dirs --contains PATH exit 0 when PATH is inside a shared directory

Reads the [shared.*] tables of machines.toml (next to this script's repo, or
SHARED_DIRS_FILE). This machine is SHARED_DIRS_SELF, else JOB_CONTAINER_SELF
(inside a container), else the short hostname. Prints nothing and exits 0 on a
machine in no pair, so callers can test for empty output.

Why it exists: on a shared checkout a raw `git worktree prune' deletes the
other machine's worktree records (bin/git-worktree-prune-safe). Tools that
might prune -- agent-prune -- ask this first.
"""
import os
import socket
import sys
import tomllib
from pathlib import Path


def inventory():
    path = os.environ.get("SHARED_DIRS_FILE") or str(Path(__file__).resolve().parent.parent / "machines.toml")
    try:
        return tomllib.loads(Path(path).read_text())
    except FileNotFoundError:
        return {}


def this_machine():
    for var in ("SHARED_DIRS_SELF", "JOB_CONTAINER_SELF"):
        if os.environ.get(var):
            return os.environ[var].lower()
    return socket.gethostname().split(".")[0].lower()


def pairs(me):
    for name, pair in inventory().get("shared", {}).items():
        machines = [m.lower() for m in pair.get("machines", [])]
        if me in machines:
            yield name, [m for m in machines if m != me], pair.get("dirs", [])


def shared_dirs(me):
    seen = []
    for _, _, dirs in pairs(me):
        for d in dirs:
            p = os.path.realpath(os.path.expanduser(d))
            if p not in seen:
                seen.append(p)
    return seen


def main(argv):
    me = this_machine()
    if not argv:
        for d in shared_dirs(me):
            print(d)
        return 0
    if argv[0] == "--with" and len(argv) == 1:
        others = []
        for _, other, _ in pairs(me):
            others += [o for o in other if o not in others]
        for o in others:
            print(o)
        return 0
    if argv[0] == "--contains" and len(argv) == 2:
        target = os.path.realpath(os.path.expanduser(argv[1]))
        return 0 if any(target == d or target.startswith(d + os.sep) for d in shared_dirs(me)) else 1
    if argv[0] in ("-h", "--help"):
        print(__doc__.strip())
        return 0
    print(__doc__.strip().splitlines()[2], file=sys.stderr)
    return 64


if __name__ == "__main__":
    sys.exit(main(sys.argv[1:]))
