#!/bin/sh
# git's gpg.program inside guix-dev (GIT_CONFIG_* in compose.guix.yaml): warn
# before a signature that will need the passphrase, then run the real gpg.
#
# The container signs through the Mac agent's restricted extra socket
# (build-aux/guix-container-gpg-bridge.sh), which has its own passphrase cache
# and may not prompt here: the Mac agent asks on the Mac's own screen instead.
# Without this note a cold cache looks like a hung `git commit' (the window is
# waiting on a display you cannot see) or an unexplained "Inappropriate ioctl
# for device" (the agent's startup tty was an ssh login that has since closed).
#
# KEYINFO is allowed on the extra socket; field 7 is "1" when the key's
# passphrase is cached for restricted clients.  Anything unexpected stays quiet.

signing=
for arg in "$@"; do
    case "$arg" in
        --sign|--detach-sign|--clearsign|--clear-sign) signing=1 ;;
        --*) ;;
        -*[bs]*) signing=1 ;;
    esac
done

if [ -n "$signing" ]; then
    key=$(git config user.signingkey 2>/dev/null)
    case $key in *!) pinned=1 ;; *) pinned= ;; esac
    want=${key%!}
    # Which key will gpg sign with?  This mirrors gpg's own choice
    # (g10/getkey.c, finish_lookup), so the cache test below is for the key
    # that will actually ask for a passphrase:
    #   - user.signingkey ends in `!': exactly that key (primary or subkey);
    #   - otherwise the newest (latest creation date) signing-capable subkey
    #     that is not expired, revoked or invalid;
    #   - otherwise the primary.
    # (gpg also skips subkeys whose secret it lacks; through the hub's agent
    # every machine's secret is present, which is why an unpinned key signs
    # with the newest machine's subkey here.)  With no user.signingkey, the
    # first key listed stands in for gpg's default key.
    # Prints: TYPE KEYID FINGERPRINT KEYGRIP   (TYPE is pub or sub).
    chosen=$(gpg --with-colons --with-keygrip --list-keys ${want:+"$want"} 2>/dev/null |
        awk -F: -v want="$want" -v pinned="$pinned" '
        function suffix(a, b,    la, lb) {
            la = length(a); lb = length(b)
            if (la == 0 || lb == 0) return 0
            if (la <= lb) return substr(b, lb - la + 1) == a
            return substr(a, la - lb + 1) == b
        }
        BEGIN { want = toupper(want); sub(/^0X/, "", want); n = 0 }
        $1 == "pub" && n > 0 { stop = 1 }
        stop { next }
        $1 == "pub" || $1 == "sub" {
            n++; type[n] = $1; id[n] = toupper($5); val[n] = $2
            created[n] = $6 + 0; caps[n] = $12
            next
        }
        $1 == "fpr" && n > 0 && fpr[n] == "" { fpr[n] = toupper($10) }
        $1 == "grp" && n > 0 && grp[n] == "" { grp[n] = $10 }
        END {
            best = 0
            if (pinned != "") {
                for (k = 1; k <= n; k++)
                    if (suffix(want, fpr[k]) || suffix(want, id[k])) { best = k; break }
            } else {
                for (k = 2; k <= n; k++)
                    if (type[k] == "sub" && index(caps[k], "s") > 0 &&
                        val[k] != "e" && val[k] != "r" && val[k] != "i" &&
                        (best == 0 || created[k] > created[best]))
                        best = k
                if (best == 0 && n > 0) best = 1
            }
            if (best > 0 && grp[best] != "")
                print type[best], id[best], fpr[best], grp[best]
        }')
    ktype=${chosen%% *}
    rest=${chosen#* }
    kid=${rest%% *}
    rest=${rest#* }
    kfpr=${rest%% *}
    grip=${rest#* }
    [ -n "$chosen" ] || grip=
    cached=$(gpg-connect-agent --no-autostart "KEYINFO $grip" /bye 2>/dev/null |
             awk '$2 == "KEYINFO" {print $7}')
    if [ -n "$grip" ] && [ "$cached" = - ]; then
        case $ktype in sub) what="signing subkey" ;; *) what="primary key" ;; esac
        owner=$("$(dirname "$0")/../bin/gpg-key-owner" "$kid" 2>/dev/null) || owner=
        case $owner in
            "machine "*) whose=" -- ${owner#machine } (machines.toml)" ;;
            primary) whose=" -- the PRIMARY (master) key (machines.toml)" ;;
            unassigned) whose=" -- not assigned to any machine in machines.toml" ;;
            *) whose= ;;
        esac
        # git captures gpg's stderr and shows it only on failure, so write to
        # the terminal directly while the prompt is pending.
        # (Probe in a subshell: a failed redirection on exec ends dash.)
        if (exec 3>/dev/tty) 2>/dev/null; then exec 3>/dev/tty; else exec 3>&2; fi
        printf 'gpg: passphrase needed for %s %s%s.\n' "$what" "$kid" "$whose" >&3
        if [ -z "$pinned" ] && [ "$ktype" = sub ]; then
            printf '     user.signingkey (%s) has no "!", so gpg chose the newest signing subkey.\n' "${key:-unset}" >&3
            printf '     To pin a key, put  [user] signingkey = %s!\n' "$kfpr" >&3
            printf '     in ~/.config/git/gpg-machine.conf (docs/GPG.md, "Which passphrase am I being asked for?").\n' >&3
        fi
        cat >&3 <<'EOF'
     Look for the pinentry window on the containing Mac.
     If signing fails, run these from ~/dot_files in a LOCAL terminal on
     the containing Mac (minius), outside orb-guix / guix-dev:
       make check-gpg-bridge
       make unlock-gpg
     The first checks the bridge; if it passes but signing remains locked,
     the second prompts for your signing-key passphrase on the Mac.
     Then retry the original command inside the container and answer any
     Mac pinentry window: the container has a separate passphrase cache.
     See docs/GPG.md, "Signing inside the guix-dev container".
EOF
    fi
fi

if [ -n "$signing" ]; then
    gpg "$@"
    result=$?
    if [ "$result" -ne 0 ]; then
        cat >&2 <<'EOF'
gpg: signing failed inside orb-guix / guix-dev.
     On the containing Mac (minius), in a LOCAL terminal at ~/dot_files:
       make check-gpg-bridge
     If that check passes but signing is still locked, run there:
       make unlock-gpg
     Then retry inside the container; answer any pinentry window on the Mac.
     A working bridge does not mean the signing passphrase is cached.
     The container has a separate cache, so unlocking on the Mac alone may
     not unlock it. If pinentry still fails, see docs/GPG.md,
     "Signing inside the guix-dev container" (agent startup environment).
EOF
    fi
    exit "$result"
fi
exec gpg "$@"
