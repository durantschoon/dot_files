# Deployed by guix home as a read-only symlink into the store.
# After editing this file, run `make apply` (or `make apply-wayland`)
# in ~/dot_files for the change to take effect.
# Do NOT use `git config --global` -- it would replace the symlink
# with a detached copy that stops tracking this repo.
#
# On macOS ~/.gitconfig is a real file that pulls this one in with
# `[include] path = ~/dot_files/.gitconfig' (make install-gnupg adds it);
# anything set later in ~/.gitconfig overrides what is here.
[user]
	name = Durant Schoon
	email = durant.schoon@gmail.com
	# Long id of the key in gnupg/gpg.conf's default-key.  The secret key
	# must be on every machine that commits: docs/GPG.md, "New machine".
	signingkey = 0x6A2DAE7008D4F938
[commit]
	gpgsign = true
[tag]
	gpgsign = true
# No gpg.program: git runs `gpg' from PATH, which is Homebrew's on macOS and
# the guix profile's on Linux.  Hard-coding a path (the old
# /usr/local/bin/gpg -> MacGPG2) breaks on the next machine.
[init]
	defaultBranch = main
[core]
	editor = emacs
[pull]
	# Rebase local commits onto upstream instead of merging; also silences
	# git's "divergent branches" prompt on fresh machines.
	rebase = true
[rebase]
	autosquash = true
	# Stash a dirty tree around pull/rebase (matches mr-push-ahead).
	autoStash = true
	# Move stacked branch refs along when rebasing the branch under them.
	updateRefs = true
[rerere]
	# Remember conflict resolutions and replay them on the next rebase.
	enabled = true
[fetch]
	prune = true
[advice]
	# pull.rebase drops commits already upstream; don't hint about it each time.
	skippedCherryPicks = false
[push]
	autoSetupRemote = true
[diff]
	submodule = log
[alias]
	alias-pr = "!f() { git fetch -fu ${2:-origin} refs/pull/$1/head:pr/$1 && git checkout pr/$1; }; f"
	alias-sdiff = !git diff && git submodule foreach 'git diff'
	alias-spush = push --recurse-submodules=on-demand
	alias-supdate = submodule update --remote --merge
[protocol "rad"]
	allow = always

