# -*- mode: shell-script -*-

# umask 002 (group-writable files) helps when working as root in Docker
# containers with mounted volumes.  Not on macOS: there it makes every
# directory Homebrew creates group-writable, and compinit then refuses the
# completion dirs under /opt/homebrew/share ("insecure directories") on every
# new shell.  macOS keeps the default 022.
[[ "$OSTYPE" == darwin* ]] || umask 002

# Custom completion function path (must precede compinit so completions are indexed)
mkdir -p ~/.zfunc
if [[ -L /usr/share/zsh/vendor-completions/_docker && ! -e /usr/share/zsh/vendor-completions/_docker && ! -f ~/.zfunc/_docker ]]; then
    cat << 'EOF' > ~/.zfunc/_docker
#compdef docker
# Fallback stub for Docker Desktop when stopped on WSL
if [[ -r /mnt/wsl/docker-desktop/cli-tools/usr/share/zsh/vendor-completions/_docker ]]; then
    source /mnt/wsl/docker-desktop/cli-tools/usr/share/zsh/vendor-completions/_docker "$@"
fi
EOF
fi
fpath=(~/.zsh ~/.zfunc $fpath)

# Enable completion system.
#
# Plain `compinit' stops to ask "Ignore insecure directories and continue?"
# whenever compaudit dislikes a dir in fpath or one of its PARENTS -- on macOS
# typically a group-writable /opt/homebrew/share, the parent of Homebrew's
# zsh-completions dir.  Homebrew's own fix is `chmod -R go-w $(brew
# --prefix)/share'; `make set_up_links' runs it.  A new shell must never block
# on that question, so audit first: if something is insecure, say what and how
# to fix it, then load with -i, which skips the insecure dirs instead of asking.
# ZSH_DISABLE_COMPFIX in .mac.zshenv does not help here -- oh-my-zsh reads
# it, compinit does not.  compaudit lists the dirs on stdout, header on stderr.
autoload -Uz compinit compaudit
if _insecure_dirs=$(compaudit 2>/dev/null); [[ -z "$_insecure_dirs" ]]; then
    compinit
else
    print -u2 "compinit: skipping insecure completion dirs: ${(f)_insecure_dirs}"
    print -u2 "          fix: chmod -R go-w ${(f)_insecure_dirs}   (then open a new shell)"
    compinit -i
fi
unset _insecure_dirs

# History configuration
HISTFILE=~/.zsh_history
HISTSIZE=10000000
SAVEHIST=10000000
setopt SHARE_HISTORY          # Share history between sessions
setopt APPEND_HISTORY         # Append to history, don't replace
setopt INC_APPEND_HISTORY     # Write to history immediately, not when shell exits
setopt HIST_IGNORE_ALL_DUPS   # Remove old duplicate commands
setopt HIST_EXPIRE_DUPS_FIRST # Expire duplicates first if limited

# Directory navigation
setopt AUTO_PUSHD

# Key bindings for history search
bindkey "^R" history-incremental-pattern-search-backward
bindkey "^S" history-incremental-pattern-search-forward

# Completion configuration
zstyle ':completion:*' menu select
zstyle ':completion:*' matcher-list 'm:{a-zA-Z}={A-Za-z}'

# Load aliases
[[ -f $HOME/.aliases ]] && source $HOME/.aliases

# Shared configuration is NOT sourced here.
#
# There used to be `[ -f ~/.shared.zshrc ] && source ~/.shared.zshrc', which is
# dead under guix home and looks like a missing file when you go looking: no
# ~/.shared.zshrc link exists, so the [ -f ] guard fails and the line silently
# does nothing.
#
# That is not a broken deployment. home-zsh-configuration CONCATENATES the files
# in its `zshrc' field into one ~/.config/zsh/.zshrc rather than symlinking each
# into $HOME -- .shared.zshrc is the next entry in that list, so its contents
# already follow this file's, in order, with nothing to source. (Confirmed: the
# generated .zshrc is 254 lines and contains .shared.zshrc's definitions.)
#
# Restoring the line would be actively wrong -- if ~/.shared.zshrc ever did
# exist, everything in it would run twice.  Machines that DO symlink it into
# $HOME use the top-level .zshrc, which keeps its own copy of the line.

# Environment-specific configuration
[[ -f ~/.HOME && -f ~/dot_files/.home.zshrc ]] && source ~/dot_files/.home.zshrc
[[ -f ~/.WORK && -f ~/dot_files/.work.zshrc ]] && source ~/dot_files/.work.zshrc

# Initialize starship prompt
if command -v starship >/dev/null 2>&1; then
    eval "$(starship init zsh)"
    # Starship's right prompt shows the history event number (%h, the N in
    # !N), but starship is a child process: hand it over in the environment.
    _starship_export_histno() { export STARSHIP_HISTNO=${(%):-%h} }
    autoload -Uz add-zsh-hook
    add-zsh-hook precmd _starship_export_histno
else
    if [[ "$OSTYPE" == darwin* ]]; then
        echo "Starship not found. Install with: brew install starship  (make set_up_links does this)"
    else
        echo "Starship not found. Install with: guix install starship"
    fi
    # Fallback prompt
    PROMPT='%n@%m %2~ %# '
fi

# GPG configuration
export GPG_TTY=$(tty)

# Over ssh, ask for the passphrase in THIS terminal.  gpg forwards
# PINENTRY_USER_DATA to the pinentry that gpg-agent launches; on macOS that
# is bin/pinentry-auto, which then runs pinentry-curses instead of opening a
# pinentry-mac window on the Mac's own screen (invisible from here, so the
# commit would hang).  On Linux the agent's pinentry is the pinentry-auto
# chooser from home/common.scm (session-pinentry), which honours it the same
# way: pinentry-curses here rather than a WSLg window on the Windows desktop,
# or a GNOME prompt on a locked desktop that fails with "pinentry error".
if [[ -n "$SSH_CONNECTION" ]]; then
    export PINENTRY_USER_DATA=USE_TTY=1
fi

# Tell gpg-agent which terminal to prompt on for SSH.  GPG_TTY above only
# reaches gpg-agent from gpg itself; ssh never passes it, so for a `git push'
# the agent uses the terminal last registered by updatestartuptty.  Where there
# is no graphical prompter (a headless box, where pinentry-gnome3 finds no gcr
# prompter and falls back to the terminal), an unregistered or closed terminal
# means "agent refused operation" and the push fails.  WSL was that case until
# the pinentry-auto chooser gave it a WSLg window; `make check-ssh' says which
# one a machine is in.
#
# Trade-off: this points the agent at the most recently opened shell, so an
# unlock prompt can land in a different window from the one you pushed from.
#
# Only when SSH_AUTH_SOCK is gpg-agent's socket, so a machine using another
# ssh agent (macOS keychain, say) is untouched; --no-autostart so opening a
# shell never starts a gpg-agent that was not already running; -t 0 so shells
# with no terminal do not register "not a tty".
if [[ -t 0 && "$SSH_AUTH_SOCK" == *gpg-agent.ssh* ]] && (( $+commands[gpg-connect-agent] )); then
    gpg-connect-agent --no-autostart updatestartuptty /bye >/dev/null 2>&1
fi

# Console ninja (if available)
# Re-added defensively: guix home's .zprofile runs `emulate sh -c ". /etc/profile"',
# which can rebuild PATH after .zshenv ran.  Use add_to_front_of_path rather than
# a raw PATH= assignment -- `typeset -U path' enforces uniqueness only when the
# ARRAY is assigned, so "PATH=dir:$PATH" silently bypasses it and stacks a second
# copy of dir every time.  (That is what put .console-ninja/.bin at both position
# 1 and position 4.)  The array form is idempotent, so re-adding costs nothing.
add_to_front_of_path "$HOME/.console-ninja/.bin"

# AVN (if available)
[[ -s "$HOME/.avn/bin/avn.sh" ]] && source "$HOME/.avn/bin/avn.sh"


# Tab title (if not in Emacs)
if [[ -z "$INSIDE_EMACS" ]]; then
    precmd() {
        echo -ne "\e]1;${PWD##*/}\a"
    }
fi

# On cd into ~/dot_files, remind which command applies this host's config.
# Runs on cd only (not at shell start), and only in interactive shells.
# The OrbStack guix container gets a random hostname, so it is recognised
# by /proc/version, and Termux by $TERMUX_VERSION or its data directory,
# as the Makefile's flavor detection does.
function dotfiles_apply_hint() {
    [[ -o interactive ]] || return
    [[ "${PWD:A}" == "${${:-$HOME/dot_files}:A}" ]] || return
    local short_host="${(L)HOST%%.*}"
    local hint
    if grep -qi orbstack /proc/version 2>/dev/null; then
        hint="you're in orb-guix, you run: make apply"
    elif [[ -n "$TERMUX_VERSION" || -d /data/data/com.termux ]]; then
        hint="you're on your android phone, just pull and source your z dots: git pull && source ~/.zshrc"
    else
        case "$short_host" in
            barnowl) hint="you're on barnowl (WSL), you run: make apply (Guix the package manager + guix home; no Guix System here, so not apply-wayland)" ;;
            minius)  hint="you're on minius, you just pull and source your z dots: git pull && source ~/.zshrc (but see if you can do everything in orb-guix, where you run: make apply)" ;;
            geeeks)  hint="you're on geeeks, you run: make apply-wayland" ;;
            *)       return ;;
        esac
    fi
    print -P "%F{yellow}${hint}%f"
}
autoload -Uz add-zsh-hook
add-zsh-hook chpwd dotfiles_apply_hint
