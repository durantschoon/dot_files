# ---------------------------------------------------------------------------
# ~/Repos/enveloped -- ONE repo (envelope.git) checked out as git worktrees,
# one directory per branch, named after the branch.  LIM holds the real .git
# and is created first (order = 5); every other entry is
# `git worktree add' off it, which is what a fresh host needs to rebuild the
# same layout with `mr --force checkout'.  update/push/status work per
# worktree as usual.
# ---------------------------------------------------------------------------

[Repos/enveloped/LIM]
order = 5
checkout = git clone -b LIM 'git@bitbucket.org:systematic-improvement/envelope.git' 'LIM'

[Repos/enveloped/gafro-benchmarks]
checkout = git -C "$MR_REPO/../LIM" worktree add "$MR_REPO" 'gafro-benchmarks'

[Repos/enveloped/gafro-cpp]
checkout = git -C "$MR_REPO/../LIM" worktree add "$MR_REPO" 'gafro-cpp'

[Repos/enveloped/gafro-idris2]
checkout = git -C "$MR_REPO/../LIM" worktree add "$MR_REPO" 'gafro-idris2'

[Repos/enveloped/gafro-rust]
checkout = git -C "$MR_REPO/../LIM" worktree add "$MR_REPO" 'gafro-rust'

[Repos/enveloped/guix-platform-install]
checkout = git -C "$MR_REPO/../LIM" worktree add "$MR_REPO" 'guix-platform-install'

[Repos/enveloped/main]
checkout = git -C "$MR_REPO/../LIM" worktree add "$MR_REPO" 'main'

[Repos/enveloped/obsidian-drift]
checkout = git -C "$MR_REPO/../LIM" worktree add "$MR_REPO" 'obsidian-drift'

[Repos/enveloped/tree-sitter-idris2]
checkout = git -C "$MR_REPO/../LIM" worktree add "$MR_REPO" 'tree-sitter-idris2'
