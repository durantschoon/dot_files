# -*- mode: toml -*-
# ~/.mrconfig -- myrepos (mr): one git command over every working repo.
#
# `mr` is Joey Hess's multi-repo driver (the same author as moreutils, which
# is why the two get confused).  Package names: `myrepos` on Guix and apt,
# `mr` in Homebrew.  It reads this file and runs one action in each repo:
#
#   mr ls                  list the repos in scope
#   mr status              what is dirty / ahead / behind, per repo
#   mr update              git pull in every repo   (mr -j4 update: 4 at once)
#   mr push                git push in every repo
#   mr --force checkout    clone every listed repo that is missing (new host)
#
# SCOPE: mr acts on the repos at or below the current directory, and it
# resolves symlinks first.  From ~ that is everything listed that really
# lives under ~.  A repo reached through a symlink onto another volume is
# out of scope from ~; `mr-all` in .aliases (= mr -d /) takes every repo,
# wherever it resolves.
#
# Section names are paths RELATIVE TO THIS FILE'S DIRECTORY.  The file is
# deployed as ~/.mrconfig (Guix Home via home/common.scm, native hosts via
# `make set_up_links`), so `[dot_files]` means ~/dot_files on every host.
#
# Where a repo belongs -- dot_files is PUBLIC, so the list is split:
#   public repo     -> a section in THIS file (committed here, shared)
#   private repo    -> dot_files/private/mrconfig, a private submodule the
#                      include below merges in; same syntax, never public
#   this host only  -> ~/.mrconfig.local, also merged in and never committed.
#                      `mr-register` (.aliases) appends the current repo
#                      there.  Plain `mr register` would write to ~/.mrconfig,
#                      which on Guix Home hosts is a read-only store symlink
#                      and on native hosts is this repo file.
#
# `skip = lazy` below means a listed repo that is not cloned on this host is
# silently skipped by every action, checkout included -- so the shared list
# can name repos only some hosts carry.  `mr --force checkout` overrides the
# skip and clones whatever is missing.  Without it, `mr update` would clone
# every absent repo and `mr status` would report each one as a failure.
# See docs/MYREPOS.md for the longer story.

[DEFAULT]
skip = lazy || offline_volume
# local_only: for repos with NO remote.  Skip when absent (like lazy) and
# skip the network verbs, so `mr update' / `mr push' stay quiet while
# `mr status', `mr diff', `mr log' still cover them.  Used as
#   skip = local_only "$1"
# brief: one line per repo that has something to report, nothing for the
# clean ones.  `mr-brief' in .aliases wraps it (mr -d / -m brief, headers
# stripped) so the whole estate fits on one screen:
#   Repos/ds/embodied-tamp     main        ^ 0 v 0  M10 ? 2 S 0
# columns: repo, branch, commits ahead ^ / behind v of upstream (- = no
# upstream), Modified tracked files, ? untracked, S stashes, then
# `sub path^N' for submodules holding N commits that are on no remote.
brief =
    branch=$(git symbolic-ref --short -q HEAD || git rev-parse --short HEAD)
    # keep the branch column aligned: cut long names to 19 chars plus `~'
    [ ${#branch} -gt 20 ] && branch="$(printf '%.19s' "$branch")~"
    if git rev-parse -q --verify '@{u}' >/dev/null 2>&1; then
        ahead=$(git rev-list --count '@{u}..HEAD')
        behind=$(git rev-list --count 'HEAD..@{u}')
    else
        ahead=-; behind=-
    fi
    st=$(git status --porcelain 2>/dev/null)
    # mr runs actions under `set -e' and grep -c exits 1 on a zero count
    mod=$(printf '%s\n' "$st" | grep -c '^[^?]' || true)
    unt=$(printf '%s\n' "$st" | grep -c '^??' || true)
    stash=$(git stash list 2>/dev/null | wc -l | tr -d ' ')
    # Submodules with commits on no remote, as ` path^N' each.  The columns
    # above see only the superproject, where an unpushed submodule is just
    # `M 1' (its moved pointer).  "On no remote" rather than "ahead of @{u}"
    # so a detached submodule HEAD -- the usual state -- still counts; a
    # submodule with no remotes at all is skipped.  Uses the last fetch.
    subs=$(git submodule foreach --quiet --recursive '
        git remote | grep -q . || exit 0
        n=$(git rev-list --count HEAD --not --remotes)
        [ "$n" -gt 0 ] && printf " %s^%s" "$displaypath" "$n"
        true' 2>/dev/null || true)
    # same for the repo column, but cut from the LEFT so the repo's own name
    # survives (a repo outside ~ shows its resolved path, which is long)
    repo="${MR_REPO#$HOME/}"
    [ ${#repo} -gt 42 ] && repo="~$(printf '%s' "$repo" | tail -c 41)"
    # MR_BRIEF_NOTE=1 (mr-brief-deluxe) adds the repo's jobs-notes headline:
    # newest logs/*.notes.md first, first non-empty `#' heading or `> ' line
    # wins -- the same rule as herdr-notes-sync in .jobs.zsh.  A note counts
    # as something to report, so a clean repo with a note still gets a line.
    note=
    if [ -n "$MR_BRIEF_NOTE" ]; then
        for f in $(ls -t "$MR_REPO"/logs/*.notes.md 2>/dev/null); do
            [ -r "$f" ] || continue
            note=$(sed -E -n 's/^(#+|>)[[:space:]]*//p' "$f" | sed -E -n '/./{s/[[:space:]]+$//;p;q;}')
            [ -n "$note" ] && break
        done
    fi
    if [ "$ahead$behind$mod$unt$stash" != "00000" ] || [ -n "$subs$note" ]; then
        # fixed layout -- mr-brief colours by column position:
        # repo 1-42, branch 44-63, ^aa vbb  Mcc ?dd See from column 65,
        # then `  sub path^N ...' and the note, each after two spaces
        printf '%-42s %-20s ^%2s v%2s  M%2s ?%2s S%2s%s%s\n' \
            "$repo" "$branch" "$ahead" "$behind" "$mod" "$unt" "$stash" \
            "${subs:+  sub$subs}" "${note:+  $note}"
    fi
# pushahead: `git push' only where the branch is ahead of its upstream.
# Repos with no upstream or nothing to push exit quietly, so with -m they
# vanish from the output and `mr push' noise (and its failures on repos
# that cannot push) is gone.  Extra arguments reach git push:
#   mr-push-ahead --dry-run     (.aliases wrapper: mr -d / -m pushahead)
pushahead =
    super_ahead=0
    if git rev-parse -q --verify '@{u}' >/dev/null 2>&1 && [ "$(git rev-list --count '@{u}..HEAD')" -gt 0 ]; then
        super_ahead=1
    fi
    subs=$(git submodule foreach --quiet --recursive '
        git remote | grep -q . || exit 0
        [ "$(git rev-list --count HEAD --not --remotes)" -gt 0 ] && echo "$displaypath"
        true' 2>/dev/null || true)
    [ "$super_ahead" -eq 1 ] || [ -n "$subs" ] || exit 0
    dry_run=0
    for arg in "$@"; do
        if [ "$arg" = "--dry-run" ] || [ "$arg" = "-n" ]; then
            dry_run=1
            break
        fi
    done
    if [ -n "$subs" ]; then
        for sub in $subs; do
            # Make the output bold cyan
            printf '\033[1;36mPushing submodule %s\033[0m\n' "$sub"
            [ "$dry_run" -eq 1 ] || { rad_sync_fetch "$sub"; git -C "$sub" pull --rebase --autostash; }
            if [ "$dry_run" -eq 1 ] && is_rad "$sub"; then
                echo "(dry run) rad remote: would push $(git -C "$sub" log --oneline HEAD --not --remotes | wc -l | tr -d ' ') commit(s)"
            else
                git -C "$sub" push "$@"
            fi
        done
    fi
    if [ "$super_ahead" -eq 1 ]; then
        [ "$dry_run" -eq 1 ] || { rad_sync_fetch .; git pull --rebase --autostash; }
        if [ "$dry_run" -eq 1 ] && is_rad .; then
            echo "(dry run) rad remote: would push $(git rev-list --count '@{u}..HEAD') commit(s)"
        else
            git push "$@"
        fi
    fi
lib =
    # rad_sync_fetch DIR: for a Radicle repo (origin is rad://...), pull the
    # peers' latest refs into local storage first.  git-remote-rad serves
    # `git fetch'/`git pull' from ~/.radicle/storage only, so without this a
    # pull --rebase sees a stale origin and the push is refused as non-fast-
    # forward.  The repo id is passed explicitly: bare `rad sync' finds the
    # repo through a remote NAMED `rad', and a clone whose Radicle remote is
    # `origin' (every submodule) gets "Current directory is not a Radicle
    # repository".  The push itself needs nothing extra: git-remote-rad signs
    # it and the running node announces it -- but git-remote-rad refuses
    # --dry-run, so pushahead only reports rad pushes in that mode.
    # A no-op for every other remote.
    is_rad() {
        case "$(git -C "$1" remote get-url origin 2>/dev/null)" in
            rad://*) return 0 ;;
            *) return 1 ;;
        esac
    }
    rad_sync_fetch() {
        is_rad "$1" || return 0
        command -v rad >/dev/null 2>&1 || return 0
        # rad://<RID>[/<NID>] -> rad:<RID>
        rid=$(git -C "$1" remote get-url origin)
        rid=${rid#rad://}
        rad sync --fetch "rad:${rid%%/*}" || true
    }
    local_only() {
        [ ! -d "$MR_REPO" ] && return 0
        offline_volume && return 0
        case "$1" in update|push|fetch) return 0 ;; *) return 1 ;; esac
    }
    # offline_volume: skip a repo that resolves onto an external drive
    # (/Volumes, /media, /run/media, /mnt) unless that drive is here AND
    # usable from this process.  Mounted is not enough: macOS privacy can
    # refuse a terminal, or a launchd-started tmux, a removable volume, and
    # then every git in it fails with "getcwd ... Operation not permitted".
    # A repo not resolvable at all is left to lazy.
    offline_volume() {
        real=$(realpath "$MR_REPO" 2>/dev/null) || return 1
        case "$real" in
            /Volumes/*|/media/*|/run/media/*|/mnt/*) ;;
            *) return 1 ;;
        esac
        (cd "$real" && /bin/pwd && ls .) >/dev/null 2>&1 && return 1
        return 0
    }
# The private list and the host-only list.  `include` runs a shell command
# and parses its output as more config, relative to this file's directory
# like everything else; a missing file is silently fine.
include = cat "$HOME/dot_files/private/mrconfig" "$HOME/.mrconfig.local" 2>/dev/null || true

# ---------------------------------------------------------------------------
# PUBLIC repos.  Everything else lives in private/mrconfig.
# ---------------------------------------------------------------------------

[dot_files]
# This repo.  On the Mac the origin is the ssh host alias `github.com-ds`
# (its own deploy key); the plain host works everywhere and checkout only
# runs when the directory is absent, so an existing clone keeps its remote.
# Submodules (espanso/private, claude) are handled by `make submodule-pull`
# and `make submodule-push`, not by mr.
checkout = git clone 'git@github.com:durantschoon/dot_files.git' 'dot_files'

[guix-config]
checkout = git clone 'git@github.com:durantschoon/guix-config.git' 'guix-config'

[Repos/ds/cargo-poly]
checkout = git clone 'ssh://git@codeberg.org/durantschoon/cargo-poly.git' 'cargo-poly'

[Repos/ds/consistent-lib]
checkout = git clone 'git@github.com:durantschoon/consistent-lib.git' 'consistent-lib'

[Repos/ds/durantschoon.github.io]
checkout = git clone 'git@github.com:durantschoon/durantschoon.github.io.git' 'durantschoon.github.io'

[Repos/ds/eigenblade-site]
checkout = git clone 'git@github.com:durantschoon/eigenblade-site.git' 'eigenblade-site'

[Repos/ds/embodied-tamp]
checkout = git clone 'https://github.com/durantschoon/embodied-tamp' 'embodied-tamp'

[Repos/ds/free-up-space-macos]
checkout = git clone 'https://github.com/durantschoon/free-up-space-macos.git' 'free-up-space-macos'

[Repos/ds/idris2-agent-tools]
checkout = git clone 'git@github.com:durantschoon/idris2-agent-tools.git' 'idris2-agent-tools'

[Repos/ds/julia-agent-tools]
checkout = git clone 'git@github.com:durantschoon/julia-agent-tools.git' 'julia-agent-tools'

[Repos/ds/ros2-classroom]
checkout = git clone 'git@github.com:durantschoon/ros2-classroom.git' 'ros2-classroom'

[Repos/others/freeplane]
# Fork of freeplane/freeplane on branch 1.12.x.  Cloned before the private
# private-extensions/ clone that lives inside it (see private/mrconfig).
order = 5
checkout = git clone -b 1.12.x 'git@github.com:durantschoon/freeplane.git' 'freeplane' &&
    git -C freeplane remote add upstream 'https://github.com/freeplane/freeplane.git'

[Repos/ds/tree-sitter-idris2]
checkout = git clone 'git@github.com:durantschoon/tree-sitter-idris2.git' 'tree-sitter-idris2'

[Repos/ds/wedgeGA-symbols]
checkout = git clone 'git@github.com:durantschoon/wedgeGA-symbols.git' 'wedgeGA-symbols'

test_action = echo 'Hello from worktree .mrconfig'

