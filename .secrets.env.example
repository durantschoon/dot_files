# -*- mode: shell-script; -*-
#
# Template for ~/.secrets.env -- the REAL file, which holds actual secret
# values and is NOT tracked in git (this repo is public).  Set it up with:
#
#     cp ~/dot_files/.secrets.env.example ~/.secrets.env
#     chmod 600 ~/.secrets.env
#     # then edit ~/.secrets.env and fill in the real values
#
# ~/.shared.zshenv sources ~/.secrets.env before anything needs a secret, and
# warns at interactive shell startup about any variable listed here that is
# unset.  So every `export VAR=' below is treated as REQUIRED: add new required
# secrets here (the placeholder value is ignored -- only the name matters for
# the check) and put the real value in ~/.secrets.env.

# ttyd basic-auth credential ("user:password") for the `ebn-lab` web
# terminal (see ebn-lab-start in .aliases).
export SCHOOL_SHELL_CRED="USER:CHANGE_ME"

# OPTIONAL -- commented out so the startup check does not demand them.
# Uncomment in ~/.secrets.env only on machines that use them.
# export RUNPOD_API_KEY="CHANGE_ME"   # runpod CLI / aider on a pod
# export OPENAI_API_KEY="CHANGE_ME"   # aider --model o3-mini etc.
# export GEMINI_API_KEY="CHANGE_ME"   # gemini CLI
